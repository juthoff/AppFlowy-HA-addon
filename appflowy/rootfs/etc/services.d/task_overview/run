#!/bin/bash
# Rewrites each workspace's task overview page whenever one of its boards, cards
# or its sidebar changed, acting as the workspace owner with a token signed by
# the add-on's own JWT secret, so no account credentials are needed.
# The overview page is a document collab (partition_key 0), so rewriting it
# never retriggers this loop. partition_key: 1 database, 3 folder, 4 database row.
source /etc/appflowy/env

OPTIONS_FILE=/data/options.json
PYTHON=/opt/task-overview/venv/bin/python
SCRIPT=/opt/task-overview/task_overview.py
POLL=10
RETRY=60
QUERY="SELECT c.workspace_id, max(c.updated_at)::text, u.uuid, u.email
FROM af_collab c
JOIN af_workspace w ON w.workspace_id = c.workspace_id AND w.deleted_at IS NULL
JOIN af_user u ON u.uid = w.owner_uid AND u.deleted_at IS NULL
WHERE c.partition_key IN (1, 3, 4)
GROUP BY 1, 3, 4"

log() { echo "[task_overview] $*"; }
opt() { jq -r ".$1 // \"\"" "$OPTIONS_FILE"; }

if [ "$(jq -r 'if .task_overview_enabled == false then "false" else "true" end' "$OPTIONS_FILE")" != "true" ]; then
    log "disabled (task_overview_enabled: false)"
    exec sleep infinity
fi

PAGE="$(opt task_overview_page)"
FIELD="$(opt task_overview_status_field)"
args=(--summary-page="${PAGE:-Offene Aufgaben}" --status-field="${FIELD:-Status}")
while IFS= read -r s; do
    [ -n "$s" ] && args+=(--status="$s")
done < <(jq -r '(.task_overview_statuses // [])[]' "$OPTIONS_FILE")
while IFS= read -r e; do
    [ -n "$e" ] && args+=(--exclude="$e")
done < <(jq -r '(.task_overview_exclude // [])[]' "$OPTIONS_FILE")

log "waiting for postgres..."
until PGPASSWORD="${POSTGRES_PASSWORD}" psql -h 127.0.0.1 -U postgres -d postgres -c 'select 1' >/dev/null 2>&1; do
    sleep 1
done
log "waiting for appflowy_cloud and nginx..."
until curl -fsS "http://127.0.0.1:8000/health" >/dev/null 2>&1; do sleep 1; done
until curl -sS -o /dev/null "http://127.0.0.1:8099/" 2>/dev/null; do sleep 1; done

export AF_BASE="http://127.0.0.1:8099"
export AF_JWT_SECRET="${APPFLOWY_GOTRUE_JWT_SECRET}"

declare -A last retry_at
log "watching boards in all workspaces every ${POLL}s"
while true; do
    if rows="$(PGPASSWORD="${POSTGRES_PASSWORD}" psql -h 127.0.0.1 -U postgres -d postgres -tAX -F $'\t' -c "$QUERY" 2>/dev/null)"; then
        now="$(date +%s)"
        while IFS=$'\t' read -r ws ts uuid email; do
            [ -n "$ws" ] || continue
            [ "${last[$ws]-}" = "$ts" ] && continue
            [ "${retry_at[$ws]-0}" -gt "$now" ] && continue
            if s6-setuidgid appflowy timeout 300 "$PYTHON" "$SCRIPT" "${args[@]}" \
                --workspace="$ws" --as-user="$uuid" --as-email="$email" </dev/null; then
                last[$ws]="$ts"
                unset "retry_at[$ws]"
            else
                rc=$?
                log "update failed for workspace ${ws} (exit ${rc}), retrying in ${RETRY}s"
                retry_at[$ws]=$(( now + RETRY ))
            fi
        done <<< "$rows"
    fi
    sleep "$POLL"
done
