#!/bin/bash
# Rewrites the task overview page whenever a board, card or the sidebar changed.
# The overview page is a document collab (partition_key 0), so rewriting it
# never retriggers this loop. partition_key: 1 database, 3 folder, 4 database row.
source /etc/appflowy/env

OPTIONS_FILE=/data/options.json
PYTHON=/opt/task-overview/venv/bin/python
SCRIPT=/opt/task-overview/task_overview.py
POLL=10
RETRY=60
QUERY="SELECT coalesce(max(updated_at)::text, '') FROM af_collab WHERE partition_key IN (1, 3, 4)"

log() { echo "[task_overview] $*"; }
opt() { jq -r ".$1 // \"\"" "$OPTIONS_FILE"; }

if [ "$(jq -r '.task_overview_enabled // false' "$OPTIONS_FILE")" != "true" ]; then
    log "disabled (task_overview_enabled: false)"
    exec sleep infinity
fi
if [ -z "${GOTRUE_ADMIN_EMAIL}" ] || [ -z "${GOTRUE_ADMIN_PASSWORD}" ]; then
    log "disabled: admin_email/admin_password are not set"
    exec sleep infinity
fi

PAGE="$(opt task_overview_page)"
FIELD="$(opt task_overview_status_field)"
WORKSPACE="$(opt task_overview_workspace)"
args=(--summary-page="${PAGE:-Offene Aufgaben}" --status-field="${FIELD:-Status}")
[ -n "$WORKSPACE" ] && args+=(--workspace="$WORKSPACE")
while IFS= read -r s; do
    [ -n "$s" ] && args+=(--status="$s")
done < <(jq -r '(.task_overview_statuses // [])[]' "$OPTIONS_FILE")
while IFS= read -r e; do
    [ -n "$e" ] && args+=(--exclude="$e")
done < <(jq -r '(.task_overview_exclude // [])[]' "$OPTIONS_FILE")

log "waiting for postgres..."
until PGPASSWORD="${POSTGRES_PASSWORD}" psql -h 127.0.0.1 -U postgres -d postgres -c 'select 1' >/dev/null 2>&1; do
    sleep 1
done
log "waiting for appflowy_cloud and nginx..."
until curl -fsS "http://127.0.0.1:8000/health" >/dev/null 2>&1; do sleep 1; done
until curl -sS -o /dev/null "http://127.0.0.1:8099/" 2>/dev/null; do sleep 1; done

export AF_BASE="http://127.0.0.1:8099"
export AF_EMAIL="${GOTRUE_ADMIN_EMAIL}"
export AF_PASSWORD="${GOTRUE_ADMIN_PASSWORD}"

log "watching boards every ${POLL}s"
last=""
while true; do
    if cur="$(PGPASSWORD="${POSTGRES_PASSWORD}" psql -h 127.0.0.1 -U postgres -d postgres -tAX -c "$QUERY" 2>/dev/null)" \
        && [ "$cur" != "$last" ]; then
        if s6-setuidgid appflowy timeout 300 "$PYTHON" "$SCRIPT" "${args[@]}"; then
            last="$cur"
        else
            log "update failed (exit $?), retrying in ${RETRY}s"
            sleep "$RETRY"
            continue
        fi
    fi
    sleep "$POLL"
done
