+// Added by the AppFlowy Home Assistant add-on (2026-09-20, not part of upstream
+// AppFlowy-Web v0.1.18): sign in with the account's static password via the
+// standard GoTrue password grant, the same flow the desktop app and the admin
+// console use. Response handling mirrors signInOTP above.
+export async function signInPassword ({
+  email,
+  password,
+}: {
+  email: string;
+  password: string;
+  redirectTo: string;
+}) {
+  try {
+    const response = await axiosInstance?.post<{
+      access_token: string;
+      expires_at: number;
+      refresh_token: string;
+      code?: number;
+      msg?: string;
+    }>('/token?grant_type=password', {
+      email,
+      password,
+    });
+
+    const data = response?.data;
+
+    if (data && data.access_token && !data.code) {
+      refreshSessionToken(JSON.stringify(data));
+      emit(EventType.SESSION_VALID);
+      afterAuth();
+    } else {
+      emit(EventType.SESSION_INVALID);
+      return Promise.reject({
+        code: data?.code || 'invalid_credentials',
+        message: data?.msg || 'Invalid login credentials',
+      });
+    }
+    // eslint-disable-next-line
+  } catch (e: any) {
+    emit(EventType.SESSION_INVALID);
+    return Promise.reject({
+      code: e.response?.data?.code || e.response?.status,
+      message: e.response?.data?.msg || e.response?.data?.error_description || e.message,
+    });
+  }
+
+  return;
+}
