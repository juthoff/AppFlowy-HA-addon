diff --git a/src/components/login/PasswordLogin.tsx b/src/components/login/PasswordLogin.tsx
new file mode 100644
index 0000000..50c1ee6
--- /dev/null
+++ b/src/components/login/PasswordLogin.tsx
@@ -0,0 +1,107 @@
+// Added by the AppFlowy Home Assistant add-on (2026-09-20, not part of upstream
+// AppFlowy-Web v0.1.18): email + static password sign-in form, so the web UI
+// can be used without an SMTP server (the upstream page only offers the
+// emailed one-time code and OAuth providers). Structure mirrors MagicLink.tsx.
+import { AFConfigContext } from '@/components/main/app.hooks';
+import { Button } from '@/components/ui/button';
+import { Input } from '@/components/ui/input';
+import { createHotkey, HOT_KEY_NAME } from '@/utils/hotkeys';
+import React, { useContext } from 'react';
+import { useTranslation } from 'react-i18next';
+import { toast } from 'sonner';
+import isEmail from 'validator/lib/isEmail';
+
+function PasswordLogin ({ redirectTo }: { redirectTo: string }) {
+  const { t } = useTranslation();
+  const [email, setEmail] = React.useState<string>('');
+  const [password, setPassword] = React.useState<string>('');
+  const [loading, setLoading] = React.useState<boolean>(false);
+  const [error, setError] = React.useState<string>('');
+  const service = useContext(AFConfigContext)?.service;
+
+  const handleSubmit = async () => {
+    if (loading) return;
+
+    if (!isEmail(email)) {
+      toast.error(t('signIn.invalidEmail'));
+      return;
+    }
+
+    if (!password) {
+      setError(t('signIn.passwordHint'));
+      return;
+    }
+
+    setError('');
+    setLoading(true);
+
+    try {
+      await service?.signInPassword({
+        email,
+        password,
+        redirectTo,
+      });
+      // eslint-disable-next-line
+    } catch (e: any) {
+      if (e.code === 429 || e.response?.status === 429) {
+        toast.error(t('tooManyRequests'));
+      } else if (e.code === 400 || e.code === 401 || e.code === 'invalid_credentials') {
+        setError(t('web.invalidCredentials'));
+      } else {
+        setError(e.message);
+      }
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  const onKeyDown = (e: React.KeyboardEvent<HTMLInputElement>) => {
+    if (createHotkey(HOT_KEY_NAME.ENTER)(e.nativeEvent)) {
+      void handleSubmit();
+    }
+  };
+
+  return (
+    <div className={'flex w-full flex-col items-center justify-center gap-3'}>
+      <Input
+        size={'md'}
+        type={'email'}
+        autoComplete={'username'}
+        className={'w-[320px]'}
+        onChange={(e) => {
+          setError('');
+          setEmail(e.target.value);
+        }}
+        value={email}
+        placeholder={t('signIn.pleaseInputYourEmail')}
+        onKeyDown={onKeyDown}
+      />
+      <Input
+        size={'md'}
+        type={'password'}
+        autoComplete={'current-password'}
+        variant={error ? 'destructive' : 'default'}
+        helpText={error}
+        className={'w-[320px]'}
+        onChange={(e) => {
+          setError('');
+          setPassword(e.target.value);
+        }}
+        value={password}
+        placeholder={t('signIn.passwordHint')}
+        onKeyDown={onKeyDown}
+      />
+
+      <Button
+        onClick={handleSubmit}
+        size={'lg'}
+        className={'w-[320px]'}
+        loading={loading}
+      >
+        {loading ? t('signIn.signingInText') : t('signIn.loginButtonText')}
+      </Button>
+    </div>
+  );
+}
+
+export default PasswordLogin;
