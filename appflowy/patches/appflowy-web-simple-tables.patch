diff --git a/src/application/slate-yjs/utils/simpleTable.ts b/src/application/slate-yjs/utils/simpleTable.ts
new file mode 100644
index 0000000..dd9f929
--- /dev/null
+++ b/src/application/slate-yjs/utils/simpleTable.ts
@@ -0,0 +1,195 @@
+// Added by the AppFlowy Home Assistant add-on: creates simple tables and adds or
+// removes their rows and columns, in the desktop app's block shape:
+// simple_table > simple_table_row > simple_table_cell > paragraph. Per-row and
+// per-column settings in the table data are maps keyed by the index as a string,
+// so they are shifted along when rows or columns are inserted or deleted.
+import { BlockType, YBlock, YjsEditorKey, YSharedRoot } from '@/application/types';
+import {
+  createBlock,
+  dataStringTOJson,
+  deleteBlock,
+  getBlock,
+  getChildrenArray,
+  updateBlockParent,
+} from '@/application/slate-yjs/utils/yjs';
+
+export const DEFAULT_TABLE_ROWS = 2;
+export const DEFAULT_TABLE_COLUMNS = 2;
+// Width Web shows for a column without a stored width (MIN_WIDTH in blocks/simple-table/const.ts).
+export const DEFAULT_COLUMN_WIDTH = 120;
+export const MIN_COLUMN_WIDTH = 40;
+const WIDTHS_PLACEHOLDER = '__column_widths__';
+
+const ROW_DATA_KEYS = ['row_colors', 'row_aligns', 'row_bold_attributes', 'row_text_colors'];
+const COLUMN_DATA_KEYS = ['column_widths', 'column_colors', 'column_aligns', 'column_bold_attributes', 'column_text_colors'];
+
+function getChildIds(sharedRoot: YSharedRoot, block: YBlock): string[] {
+  return getChildrenArray(block.get(YjsEditorKey.block_children), sharedRoot)?.toArray() ?? [];
+}
+
+function createCell(sharedRoot: YSharedRoot, row: YBlock, index: number) {
+  const cell = createBlock(sharedRoot, { ty: BlockType.SimpleTableCellBlock, data: {} });
+
+  updateBlockParent(sharedRoot, cell, row, index);
+  const paragraph = createBlock(sharedRoot, { ty: BlockType.Paragraph, data: {} });
+
+  updateBlockParent(sharedRoot, paragraph, cell, 0);
+  return cell;
+}
+
+function createRow(sharedRoot: YSharedRoot, table: YBlock, index: number, columnCount: number) {
+  const row = createBlock(sharedRoot, { ty: BlockType.SimpleTableRowBlock, data: {} });
+
+  updateBlockParent(sharedRoot, row, table, index);
+  for(let i = 0; i < columnCount; i++) {
+    createCell(sharedRoot, row, i);
+  }
+
+  return row;
+}
+
+function getTableData(table: YBlock) {
+  return dataStringTOJson(table.get(YjsEditorKey.block_data)) as Record<string, unknown>;
+}
+
+function getColumnWidths(data: Record<string, unknown>) {
+  const widths = data.column_widths;
+
+  return widths && typeof widths === 'object' ? { ...(widths as Record<string, number>) } : {};
+}
+
+// The desktop app reads column_widths as doubles and ignores the whole map if a width is an
+// integer, so widths are written as e.g. 160.0 (JSON.stringify would write 160).
+function setTableData(table: YBlock, data: Record<string, unknown>) {
+  const widths = Object.entries(getColumnWidths(data))
+    .filter(([, width]) => typeof width === 'number' && Number.isFinite(width))
+    .map(([key, width]) => `${JSON.stringify(key)}:${Number.isInteger(width) ? width.toFixed(1) : String(width)}`);
+  const json = JSON.stringify({ ...data, column_widths: WIDTHS_PLACEHOLDER });
+
+  table.set(YjsEditorKey.block_data, json.replace(`"${WIDTHS_PLACEHOLDER}"`, `{${widths.join(',')}}`));
+}
+
+function shiftIndexedData(table: YBlock, keys: string[], index: number, delta: 1 | -1) {
+  const data = getTableData(table);
+
+  keys.forEach((key) => {
+    const map = data[key] as Record<string, unknown> | undefined;
+
+    if(!map || typeof map !== 'object') return;
+    const shifted: Record<string, unknown> = {};
+
+    Object.entries(map).forEach(([k, value]) => {
+      const i = Number(k);
+
+      if(Number.isNaN(i) || i < index) {
+        shifted[k] = value;
+        return;
+      }
+
+      if(delta < 0 && i === index) return;
+      shifted[String(i + delta)] = value;
+    });
+    data[key] = shifted;
+  });
+  setTableData(table, data);
+}
+
+// Returns the id of the first cell's paragraph, to put the cursor there.
+export function createSimpleTable(sharedRoot: YSharedRoot, parent: YBlock, index: number, rowCount = DEFAULT_TABLE_ROWS, columnCount = DEFAULT_TABLE_COLUMNS) {
+  const table = createBlock(sharedRoot, {
+    ty: BlockType.SimpleTableBlock,
+    data: {
+      enable_header_row: false,
+      enable_header_column: false,
+      column_widths: {},
+      column_colors: {},
+      column_aligns: {},
+      row_colors: {},
+      row_aligns: {},
+    },
+  });
+
+  updateBlockParent(sharedRoot, table, parent, index);
+  for(let i = 0; i < rowCount; i++) {
+    createRow(sharedRoot, table, i, columnCount);
+  }
+
+  const firstRow = getBlock(getChildIds(sharedRoot, table)[0], sharedRoot);
+  const firstCell = getBlock(getChildIds(sharedRoot, firstRow)[0], sharedRoot);
+
+  return getChildIds(sharedRoot, firstCell)[0];
+}
+
+export function getTableColumnCount(sharedRoot: YSharedRoot, table: YBlock) {
+  const firstRowId = getChildIds(sharedRoot, table)[0];
+
+  return firstRowId ? getChildIds(sharedRoot, getBlock(firstRowId, sharedRoot)).length : 0;
+}
+
+export function getTableRowCount(sharedRoot: YSharedRoot, table: YBlock) {
+  return getChildIds(sharedRoot, table).length;
+}
+
+export function insertTableRow(sharedRoot: YSharedRoot, table: YBlock, index: number) {
+  const row = createRow(sharedRoot, table, index, Math.max(getTableColumnCount(sharedRoot, table), 1));
+
+  shiftIndexedData(table, ROW_DATA_KEYS, index, 1);
+  return row.get(YjsEditorKey.block_id);
+}
+
+export function insertTableColumn(sharedRoot: YSharedRoot, table: YBlock, index: number) {
+  getChildIds(sharedRoot, table).forEach((rowId) => {
+    createCell(sharedRoot, getBlock(rowId, sharedRoot), index);
+  });
+  shiftIndexedData(table, COLUMN_DATA_KEYS, index, 1);
+}
+
+// The last row or column is kept: a table without cells can't be edited any more.
+export function deleteTableRow(sharedRoot: YSharedRoot, table: YBlock, index: number) {
+  const rowIds = getChildIds(sharedRoot, table);
+
+  if(rowIds.length <= 1 || !rowIds[index]) return;
+  deleteBlock(sharedRoot, rowIds[index]);
+  shiftIndexedData(table, ROW_DATA_KEYS, index, -1);
+}
+
+export function deleteTableColumn(sharedRoot: YSharedRoot, table: YBlock, index: number) {
+  if(getTableColumnCount(sharedRoot, table) <= 1) return;
+  getChildIds(sharedRoot, table).forEach((rowId) => {
+    const cellId = getChildIds(sharedRoot, getBlock(rowId, sharedRoot))[index];
+
+    if(cellId) deleteBlock(sharedRoot, cellId);
+  });
+  shiftIndexedData(table, COLUMN_DATA_KEYS, index, -1);
+}
+
+// Without a width the column falls back to the default width.
+export function setTableColumnWidth(table: YBlock, index: number, width?: number) {
+  const data = getTableData(table);
+  const widths = getColumnWidths(data);
+
+  if(width === undefined) {
+    delete widths[String(index)];
+  } else {
+    widths[String(index)] = Math.max(MIN_COLUMN_WIDTH, Math.round(width));
+  }
+
+  setTableData(table, { ...data, column_widths: widths });
+}
+
+// Gives every column the same width, keeping the table's total width.
+export function distributeTableColumns(sharedRoot: YSharedRoot, table: YBlock) {
+  const columnCount = getTableColumnCount(sharedRoot, table);
+
+  if(columnCount === 0) return;
+  const data = getTableData(table);
+  const widths = getColumnWidths(data);
+  const indexes = Array.from({ length: columnCount }, (_, i) => String(i));
+  const total = indexes.reduce((sum, i) => sum + (widths[i] || DEFAULT_COLUMN_WIDTH), 0);
+  const width = Math.max(MIN_COLUMN_WIDTH, Math.round(total / columnCount));
+
+  setTableData(table, {
+    ...data,
+    column_widths: Object.fromEntries(indexes.map((i) => [i, width])),
+  });
+}
