diff --git a/src/components/editor/components/blocks/simple-table/SimpleTableCellMenu.tsx b/src/components/editor/components/blocks/simple-table/SimpleTableCellMenu.tsx
new file mode 100644
index 0000000..fbd69e5
--- /dev/null
+++ b/src/components/editor/components/blocks/simple-table/SimpleTableCellMenu.tsx
@@ -0,0 +1,95 @@
+// Added by the AppFlowy Home Assistant add-on: the row and column menu of a table cell, opened with
+// the button in the cell's corner (shown while the cell is hovered or holds the cursor).
+import { YjsEditor } from '@/application/slate-yjs';
+import { CustomEditor, SimpleTableAction } from '@/application/slate-yjs/command';
+import { ReactComponent as MoreIcon } from '@/assets/icons/more.svg';
+import { Popover } from '@/components/_shared/popover';
+import { Button, Divider } from '@mui/material';
+import React, { useMemo, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { useSlateStatic } from 'slate-react';
+
+export function SimpleTableCellMenu({ cellId, canDeleteRow, canDeleteColumn }: {
+  cellId: string;
+  canDeleteRow: boolean;
+  canDeleteColumn: boolean;
+}) {
+  const { t } = useTranslation();
+  const editor = useSlateStatic() as YjsEditor;
+  const [anchorEl, setAnchorEl] = useState<HTMLElement | null>(null);
+
+  const groups = useMemo(() => {
+    const groups: { action: SimpleTableAction; label: string; disabled?: boolean }[][] = [
+      [
+        { action: 'insertRowAbove', label: t('web.tableInsertRowAbove') },
+        { action: 'insertRowBelow', label: t('web.tableInsertRowBelow') },
+        { action: 'deleteRow', label: t('web.tableDeleteRow'), disabled: !canDeleteRow },
+      ],
+      [
+        { action: 'insertColumnLeft', label: t('web.tableInsertColumnLeft') },
+        { action: 'insertColumnRight', label: t('web.tableInsertColumnRight') },
+        { action: 'deleteColumn', label: t('web.tableDeleteColumn'), disabled: !canDeleteColumn },
+      ],
+      [
+        { action: 'resetColumnWidth', label: t('web.tableResetColumnWidth') },
+        { action: 'distributeColumns', label: t('web.tableDistributeColumns') },
+      ],
+    ];
+
+    return groups;
+  }, [t, canDeleteRow, canDeleteColumn]);
+
+  return (
+    <div contentEditable={false} className={'simple-table-cell-menu absolute right-1.5 top-0.5 select-none'}>
+      <button
+        type={'button'}
+        data-testid={'simple-table-cell-menu'}
+        className={'flex h-5 w-5 items-center justify-center rounded-[4px] bg-bg-body text-text-caption hover:bg-fill-list-hover'}
+        onMouseDown={(e) => {
+          e.preventDefault();
+          e.stopPropagation();
+          setAnchorEl(e.currentTarget);
+        }}
+      >
+        <MoreIcon className={'h-4 w-4'} />
+      </button>
+      <Popover
+        open={Boolean(anchorEl)}
+        anchorEl={anchorEl}
+        onClose={() => setAnchorEl(null)}
+        disableRestoreFocus={true}
+        disableAutoFocus={true}
+        disableEnforceFocus={true}
+        anchorOrigin={{ vertical: 'bottom', horizontal: 'right' }}
+        transformOrigin={{ vertical: -4, horizontal: 'right' }}
+      >
+        <div data-testid={'simple-table-cell-menu-options'} className={'flex flex-col gap-1 p-2'}>
+          {groups.map((group, index) => (
+            <React.Fragment key={index}>
+              {index > 0 && <Divider className={'my-1'} />}
+              {group.map((option) => (
+                <Button
+                  key={option.action}
+                  data-testid={`simple-table-${option.action}`}
+                  size={'small'}
+                  color={'inherit'}
+                  className={'justify-start'}
+                  disabled={option.disabled}
+                  onMouseDown={(e) => e.preventDefault()}
+                  onClick={() => {
+                    setAnchorEl(null);
+                    CustomEditor.editSimpleTable(editor, cellId, option.action);
+                  }}
+                >
+                  {option.label}
+                </Button>
+              ))}
+            </React.Fragment>
+          ))}
+        </div>
+      </Popover>
+    </div>
+  );
+}
+
+export default SimpleTableCellMenu;
diff --git a/src/components/editor/components/blocks/simple-table/SimpleTableColumnResizer.tsx b/src/components/editor/components/blocks/simple-table/SimpleTableColumnResizer.tsx
new file mode 100644
index 0000000..751ff30
--- /dev/null
+++ b/src/components/editor/components/blocks/simple-table/SimpleTableColumnResizer.tsx
@@ -0,0 +1,73 @@
+// Added by the AppFlowy Home Assistant add-on: drag handle on a cell's right edge that changes the
+// column width. While dragging only the DOM is resized; the width is stored once on release, so
+// collaborators don't get an update per mouse move. Double-click resets the column width.
+import { YjsEditor } from '@/application/slate-yjs';
+import { CustomEditor } from '@/application/slate-yjs/command';
+import { MIN_COLUMN_WIDTH } from '@/application/slate-yjs/utils/simpleTable';
+import React, { useCallback } from 'react';
+import { useSlateStatic } from 'slate-react';
+
+function resizeColumnInDom(table: HTMLTableElement, columnIndex: number, width: number) {
+  const col = table.querySelectorAll('col')[columnIndex];
+
+  if(col) col.style.width = `${width}px`;
+  table.querySelectorAll<HTMLElement>(`td[data-cell-index="${columnIndex}"]`).forEach((cell) => {
+    cell.style.width = `${width}px`;
+    cell.style.minWidth = `${width}px`;
+  });
+}
+
+export function SimpleTableColumnResizer({ tableId, cellId, columnIndex, width }: {
+  tableId: string;
+  cellId: string;
+  columnIndex: number;
+  width: number;
+}) {
+  const editor = useSlateStatic() as YjsEditor;
+
+  const onMouseDown = useCallback((e: React.MouseEvent<HTMLDivElement>) => {
+    e.preventDefault();
+    e.stopPropagation();
+    const table = e.currentTarget.closest('table');
+
+    if(!table) return;
+    const handle = e.currentTarget;
+    const startX = e.clientX;
+    let newWidth = width;
+
+    const onMouseMove = (event: MouseEvent) => {
+      newWidth = Math.max(MIN_COLUMN_WIDTH, Math.round(width + event.clientX - startX));
+      resizeColumnInDom(table, columnIndex, newWidth);
+    };
+
+    const onMouseUp = () => {
+      document.removeEventListener('mousemove', onMouseMove);
+      document.removeEventListener('mouseup', onMouseUp);
+      document.body.style.cursor = '';
+      handle.removeAttribute('data-resizing');
+      if(newWidth !== width) {
+        CustomEditor.setSimpleTableColumnWidth(editor, tableId, columnIndex, newWidth);
+      }
+    };
+
+    document.body.style.cursor = 'col-resize';
+    handle.setAttribute('data-resizing', 'true');
+    document.addEventListener('mousemove', onMouseMove);
+    document.addEventListener('mouseup', onMouseUp);
+  }, [editor, tableId, columnIndex, width]);
+
+  return (
+    <div
+      contentEditable={false}
+      data-testid={'simple-table-column-resizer'}
+      className={'simple-table-column-resizer absolute right-0 top-0 z-[1] h-full w-[5px] cursor-col-resize select-none'}
+      onMouseDown={onMouseDown}
+      onDoubleClick={(e) => {
+        e.preventDefault();
+        CustomEditor.editSimpleTable(editor, cellId, 'resetColumnWidth');
+      }}
+    />
+  );
+}
+
+export default SimpleTableColumnResizer;
