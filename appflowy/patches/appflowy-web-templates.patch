+  async remapDocumentViewIds (workspaceId: string, documentId: string, mapping: Record<string, string>) {
+    const res = await APIService.getCollab(workspaceId, documentId, Types.Document);
+    const doc = new Y.Doc({ guid: documentId });
+
+    applyYDoc(doc, res.data);
+    const before = Y.encodeStateVector(doc);
+    const document = (doc.getMap(YjsEditorKey.data_section) as YSharedRoot).get(YjsEditorKey.document);
+
+    if (!document) return;
+    const blocks = document.get(YjsEditorKey.blocks) as YBlocks;
+    const textMap = (document.get(YjsEditorKey.meta) as YMeta).get(YjsEditorKey.text_map) as YTextMap;
+
+    doc.transact(() => {
+      blocks.forEach((value) => {
+        const block = value as Y.Map<unknown>;
+        const raw = block.get(YjsEditorKey.block_data);
+
+        if (typeof raw !== 'string') return;
+        let data: Record<string, unknown>;
+
+        try {
+          data = JSON.parse(raw);
+        } catch (e) {
+          return;
+        }
+
+        let changed = false;
+
+        ['view_id', 'parent_id'].forEach((key) => {
+          const id = data[key];
+
+          if (typeof id === 'string' && mapping[id]) {
+            data[key] = mapping[id];
+            changed = true;
+          }
+        });
+        if (changed) block.set(YjsEditorKey.block_data, JSON.stringify(data));
+      });
+
+      textMap.forEach((value) => {
+        const text = value as Y.Text;
+        let offset = 0;
+
+        text.toDelta().forEach((op: { insert: string | object; attributes?: { mention?: { page_id?: string } } }) => {
+          const length = typeof op.insert === 'string' ? op.insert.length : 1;
+          const mention = op.attributes?.mention;
+
+          if (mention?.page_id && mapping[mention.page_id]) {
+            text.format(offset, length, { mention: { ...mention, page_id: mapping[mention.page_id] } });
+          }
+
+          offset += length;
+        });
+      });
+    });
+
+    const update = Y.encodeStateAsUpdate(doc, before);
+
+    // An update with no changes is just the empty struct and delete sets.
+    if (update.length <= 2) return;
+    await APIService.updateCollab(workspaceId, documentId, Types.Document, update, { version_vector: 0 });
   }
 
