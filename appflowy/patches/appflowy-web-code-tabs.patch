diff --git a/src/components/editor/components/blocks/code/CodeTabs.tsx b/src/components/editor/components/blocks/code/CodeTabs.tsx
new file mode 100644
index 0000000..1bb7e8d
--- /dev/null
+++ b/src/components/editor/components/blocks/code/CodeTabs.tsx
@@ -0,0 +1,182 @@
+// Added by the AppFlowy Home Assistant add-on: the tab bar of a code block with several snippets.
+// A tab shows its name, or its language when it has none. Double-click a tab (or use its menu) to
+// rename it. In read-only pages, selecting a tab only changes what this viewer sees.
+import { YjsEditor } from '@/application/slate-yjs';
+import { CustomEditor } from '@/application/slate-yjs/command';
+import { ReactComponent as MoreIcon } from '@/assets/icons/more.svg';
+import { ReactComponent as PlusIcon } from '@/assets/icons/plus.svg';
+import { Popover } from '@/components/_shared/popover';
+import { supportLanguages } from '@/components/editor/components/blocks/code/constants';
+import { CodeNode } from '@/components/editor/editor.type';
+import { Button, Tooltip } from '@mui/material';
+import React, { useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { useSlateStatic } from 'slate-react';
+
+export function getLanguageTitle(language?: string) {
+  return supportLanguages.find((item) => item.id === language?.toLowerCase())?.title || 'Auto';
+}
+
+export function AddCodeTabButton({ blockId }: { blockId: string }) {
+  const { t } = useTranslation();
+  const editor = useSlateStatic() as YjsEditor;
+
+  return (
+    <Tooltip disableInteractive={true} title={t('web.codeTabAdd')}>
+      <button
+        type={'button'}
+        data-testid={'code-tab-add'}
+        className={'flex h-6 w-6 shrink-0 items-center justify-center rounded-[4px] text-text-caption hover:bg-fill-list-hover'}
+        onMouseDown={(e) => e.preventDefault()}
+        onClick={() => CustomEditor.editCodeTabs(editor, blockId, { type: 'add' })}
+      >
+        <PlusIcon className={'h-4 w-4'} />
+      </button>
+    </Tooltip>
+  );
+}
+
+export function CodeTabs({ node, readOnly, shownIndex, onShow }: {
+  node: CodeNode;
+  readOnly: boolean;
+  shownIndex: number;
+  onShow: (index: number) => void;
+}) {
+  const { t } = useTranslation();
+  const editor = useSlateStatic() as YjsEditor;
+  const { blockId, data } = node;
+  const tabs = data.tabs ?? [];
+  const active = data.active_tab ?? 0;
+  const [editingIndex, setEditingIndex] = useState<number | null>(null);
+  const [draft, setDraft] = useState('');
+  const [menu, setMenu] = useState<{ anchorEl: HTMLElement; index: number } | null>(null);
+
+  // The active tab's language is `data.language`; `tabs[active].language` is only saved on switch.
+  const label = (index: number) => tabs[index].name || getLanguageTitle(index === active ? data.language : tabs[index].language);
+
+  const startRename = (index: number) => {
+    if(readOnly) return;
+    setDraft(tabs[index].name ?? '');
+    setEditingIndex(index);
+  };
+
+  const commitRename = () => {
+    if(editingIndex === null) return;
+    if(draft.trim() !== (tabs[editingIndex]?.name ?? '')) {
+      CustomEditor.editCodeTabs(editor, blockId, { type: 'rename', index: editingIndex, name: draft });
+    }
+
+    setEditingIndex(null);
+  };
+
+  return (
+    <div className={'flex min-w-0 items-center gap-1 overflow-x-auto'}>
+      {tabs.map((_, index) => {
+        const shown = index === shownIndex;
+
+        if(index === editingIndex) {
+          return (
+            <input
+              key={index}
+              autoFocus={true}
+              value={draft}
+              data-testid={'code-tab-name-input'}
+              placeholder={t('web.codeTabNamePlaceholder') || ''}
+              className={'h-7 w-40 shrink-0 rounded-[6px] border border-line-divider bg-bg-body px-2 text-sm outline-none'}
+              onChange={(e) => setDraft(e.target.value)}
+              onBlur={commitRename}
+              onKeyDown={(e) => {
+                e.stopPropagation();
+                if(e.key === 'Enter') {
+                  e.preventDefault();
+                  commitRename();
+                } else if(e.key === 'Escape') {
+                  e.preventDefault();
+                  setEditingIndex(null);
+                }
+              }}
+            />
+          );
+        }
+
+        return (
+          <div
+            key={index}
+            className={`flex h-7 shrink-0 items-center rounded-[6px] text-sm ${shown ? 'bg-fill-list-hover font-medium text-text-title' : 'text-text-caption hover:bg-fill-list-hover'}`}
+          >
+            <button
+              type={'button'}
+              data-testid={'code-tab'}
+              className={'h-full max-w-[200px] truncate px-2'}
+              onMouseDown={(e) => e.preventDefault()}
+              onClick={() => {
+                if(shown) return;
+                if(readOnly) {
+                  onShow(index);
+                } else {
+                  CustomEditor.editCodeTabs(editor, blockId, { type: 'select', index });
+                }
+              }}
+              onDoubleClick={() => startRename(index)}
+            >
+              {label(index)}
+            </button>
+            {shown && !readOnly && (
+              <button
+                type={'button'}
+                data-testid={'code-tab-menu'}
+                className={'mr-1 flex h-5 w-5 items-center justify-center rounded-[4px] hover:bg-fill-list-active'}
+                onMouseDown={(e) => {
+                  e.preventDefault();
+                  setMenu({ anchorEl: e.currentTarget, index });
+                }}
+              >
+                <MoreIcon className={'h-4 w-4'} />
+              </button>
+            )}
+          </div>
+        );
+      })}
+
+      {!readOnly && <AddCodeTabButton blockId={blockId} />}
+
+      <Popover
+        open={Boolean(menu)}
+        anchorEl={menu?.anchorEl}
+        onClose={() => setMenu(null)}
+        disableRestoreFocus={true}
+        disableAutoFocus={true}
+        disableEnforceFocus={true}
+      >
+        <div className={'flex flex-col gap-1 p-2'}>
+          <Button
+            size={'small'}
+            color={'inherit'}
+            className={'justify-start'}
+            onMouseDown={(e) => e.preventDefault()}
+            onClick={() => {
+              if(menu) startRename(menu.index);
+              setMenu(null);
+            }}
+          >
+            {t('web.codeTabRename')}
+          </Button>
+          <Button
+            size={'small'}
+            color={'inherit'}
+            className={'justify-start'}
+            onMouseDown={(e) => e.preventDefault()}
+            onClick={() => {
+              if(menu) CustomEditor.editCodeTabs(editor, blockId, { type: 'delete', index: menu.index });
+              setMenu(null);
+            }}
+          >
+            {t('web.codeTabDelete')}
+          </Button>
+        </div>
+      </Popover>
+    </div>
+  );
+}
+
+export default CodeTabs;
