diff --git a/src/application/slate-yjs/utils/codeTabs.ts b/src/application/slate-yjs/utils/codeTabs.ts
new file mode 100644
index 0000000..762b5ff
--- /dev/null
+++ b/src/application/slate-yjs/utils/codeTabs.ts
@@ -0,0 +1,113 @@
+// Added by the AppFlowy Home Assistant add-on: tabs of a code block. The block stays a plain
+// `code` block: its text and `language` are those of the active tab, the other tabs live in
+// `data.tabs` (see CodeBlockData). Selecting a tab stores the block text into the old tab and
+// replaces it with the new tab's code.
+import { CodeBlockData, CodeTab, YBlock, YjsEditorKey, YSharedRoot } from '@/application/types';
+import { dataStringTOJson, getText } from '@/application/slate-yjs/utils/yjs';
+
+function getCodeData(block: YBlock) {
+  return dataStringTOJson(block.get(YjsEditorKey.block_data)) as CodeBlockData;
+}
+
+function setCodeData(block: YBlock, data: CodeBlockData) {
+  block.set(YjsEditorKey.block_data, JSON.stringify(data));
+}
+
+function getBlockYText(sharedRoot: YSharedRoot, block: YBlock) {
+  return getText(block.get(YjsEditorKey.block_external_id), sharedRoot);
+}
+
+function getActiveIndex(data: CodeBlockData) {
+  const tabs = data.tabs ?? [];
+  const index = data.active_tab ?? 0;
+
+  return Math.min(Math.max(index, 0), Math.max(tabs.length - 1, 0));
+}
+
+// The tabs with the active one brought up to date from the block text and language.
+function currentTabs(sharedRoot: YSharedRoot, block: YBlock, data: CodeBlockData): CodeTab[] {
+  const code = getBlockYText(sharedRoot, block)?.toString() ?? '';
+  const tabs = data.tabs?.length ? data.tabs.map((tab) => ({ ...tab })) : [{ language: data.language ?? '', code }];
+  const active = getActiveIndex(data);
+
+  tabs[active] = { ...tabs[active], language: data.language ?? '', code };
+  return tabs;
+}
+
+function showTab(sharedRoot: YSharedRoot, block: YBlock, data: CodeBlockData, tabs: CodeTab[], index: number) {
+  const yText = getBlockYText(sharedRoot, block);
+
+  if(yText) {
+    yText.delete(0, yText.length);
+    yText.insert(0, tabs[index].code);
+  }
+
+  setCodeData(block, { ...data, language: tabs[index].language, tabs, active_tab: index });
+}
+
+export function addCodeTab(sharedRoot: YSharedRoot, block: YBlock) {
+  const data = getCodeData(block);
+  const tabs = currentTabs(sharedRoot, block, data);
+
+  tabs.push({ language: data.language ?? '', code: '' });
+  showTab(sharedRoot, block, data, tabs, tabs.length - 1);
+}
+
+export function selectCodeTab(sharedRoot: YSharedRoot, block: YBlock, index: number) {
+  const data = getCodeData(block);
+
+  if(!data.tabs || index === getActiveIndex(data) || !data.tabs[index]) return;
+  showTab(sharedRoot, block, data, currentTabs(sharedRoot, block, data), index);
+}
+
+export function renameCodeTab(block: YBlock, index: number, name: string) {
+  const data = getCodeData(block);
+
+  if(!data.tabs?.[index]) return;
+  const tabs = data.tabs.map((tab, i) => {
+    if(i !== index) return tab;
+    const renamed: CodeTab = { language: tab.language, code: tab.code };
+
+    if(name.trim()) renamed.name = name.trim();
+    return renamed;
+  });
+
+  setCodeData(block, { ...data, tabs });
+}
+
+// Deleting down to one tab turns the block back into a plain code block (no `tabs`).
+export function deleteCodeTab(sharedRoot: YSharedRoot, block: YBlock, index: number) {
+  const data = getCodeData(block);
+
+  if(!data.tabs?.[index]) return;
+  const active = getActiveIndex(data);
+  const tabs = currentTabs(sharedRoot, block, data);
+
+  tabs.splice(index, 1);
+  const nextActive = index < active || active >= tabs.length ? Math.max(active - 1, 0) : active;
+
+  if(tabs.length > 1) {
+    if(index === active) {
+      showTab(sharedRoot, block, data, tabs, nextActive);
+    } else {
+      setCodeData(block, { ...data, tabs, active_tab: nextActive });
+    }
+
+    return;
+  }
+
+  const rest: CodeBlockData = { ...data };
+
+  delete rest.tabs;
+  delete rest.active_tab;
+  if(index === active) {
+    const yText = getBlockYText(sharedRoot, block);
+
+    if(yText) {
+      yText.delete(0, yText.length);
+      yText.insert(0, tabs[0].code);
+    }
+  }
+
+  setCodeData(block, { ...rest, language: tabs[0].language });
+}
