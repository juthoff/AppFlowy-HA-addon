diff --git a/src/application/database-yjs/field-write.ts b/src/application/database-yjs/field-write.ts
new file mode 100644
index 0000000..f2a91d7
--- /dev/null
+++ b/src/application/database-yjs/field-write.ts
@@ -0,0 +1,288 @@
+// Added by the AppFlowy Home Assistant add-on (not part of upstream AppFlowy-Web
+// v0.1.18, which cannot change a database's properties): creates, renames and
+// deletes fields and adds select options, in the same shape AppFlowy-Collab's
+// Rust code uses (collab-database database.rs create_field / delete_field,
+// fields/field.rs, fields/field_settings.rs, fields/type_option/*).
+//
+// - Integers are plain JS numbers (yrs: Any::Number). Rust writes Any::BigInt,
+//   but yjs 14.0.0-1 cannot store a BigInt in a map, and every Rust reader of
+//   these keys accepts whole numbers (TryFrom<Any>, serde deserialize_i64/u32).
+//   `ty` must be a number: a string would make the server and the desktop app
+//   skip the field.
+// - field_orders entries are plain {id} objects (Rust parses them as Any).
+// - A new field is added to the orders and settings of every view in the same
+//   transaction as the field itself: useFieldsSelector only observes the orders
+//   and settings, and the row page reads the field as soon as it appears there.
+import { useDatabaseContext } from '@/application/database-yjs/context';
+import { FieldType } from '@/application/database-yjs/database.type';
+import { SelectOption, SelectOptionColor, SelectTypeOption } from '@/application/database-yjs/fields/select-option/select_option.type';
+import { DatabaseViewLayout, YDatabase, YDatabaseField, YDoc, YjsDatabaseKey, YjsEditorKey } from '@/application/types';
+import { notify } from '@/components/_shared/notify';
+import { nanoid } from 'nanoid';
+import { useCallback } from 'react';
+import * as Y from 'yjs';
+
+// The types that can be created and edited on the web row page.
+export const EDITABLE_FIELD_TYPES = [
+  FieldType.RichText,
+  FieldType.Number,
+  FieldType.DateTime,
+  FieldType.SingleSelect,
+  FieldType.MultiSelect,
+  FieldType.Checkbox,
+  FieldType.URL,
+  FieldType.Checklist,
+];
+
+const DEFAULT_FIELD_WIDTH = 150;
+const OPTION_COLORS = Object.values(SelectOptionColor);
+
+const nowSeconds = () => Math.floor(Date.now() / 1000);
+
+function getDatabase (databaseDoc: YDoc) {
+  const database = databaseDoc.getMap(YjsEditorKey.data_section).get(YjsEditorKey.database) as YDatabase | undefined;
+
+  if (!database) throw new Error('Database not loaded');
+  return database;
+}
+
+function getField (database: YDatabase, fieldId: string) {
+  const field = database.get(YjsDatabaseKey.fields)?.get(fieldId) as YDatabaseField | undefined;
+
+  if (!field) throw new Error('Property not found');
+  return field;
+}
+
+// Same defaults as collab-database's default_type_option_data_from_type().
+function defaultTypeOption (type: FieldType): Record<string, unknown> {
+  switch (type) {
+    case FieldType.Number:
+      return { format: 0, scale: 0, symbol: 'RUB', name: 'Number' };
+    case FieldType.DateTime:
+      return {
+        date_format: 3,
+        time_format: 1,
+        timezone_id: Intl.DateTimeFormat().resolvedOptions().timeZone || 'Etc/UTC',
+      };
+    case FieldType.SingleSelect:
+    case FieldType.MultiSelect:
+      return { content: JSON.stringify({ options: [], disable_color: false }) };
+    case FieldType.URL:
+      return { url: '', content: '' };
+    default:
+      return {};
+  }
+}
+
+// Y.Map items (filters, sorts, groups) or plain objects.
+function fieldIdOf (item: unknown) {
+  if (item instanceof Y.Map) return item.get(YjsDatabaseKey.field_id);
+  return (item as { field_id?: string } | null)?.field_id;
+}
+
+function removeWhere (array: Y.Array<unknown> | undefined, match: (item: unknown) => boolean) {
+  if (!array) return;
+  const items = array.toArray();
+
+  for (let i = items.length - 1; i >= 0; i--) {
+    if (match(items[i])) array.delete(i, 1);
+  }
+}
+
+export function createField (databaseDoc: YDoc, name: string, type: FieldType) {
+  const database = getDatabase(databaseDoc);
+  const fields = database.get(YjsDatabaseKey.fields);
+  let fieldId = nanoid(6);
+
+  while (fields.has(fieldId)) fieldId = nanoid(6);
+
+  databaseDoc.transact(() => {
+    database.get(YjsDatabaseKey.views).forEach((view) => {
+      let orders = view.get(YjsDatabaseKey.field_orders);
+
+      if (!orders) {
+        orders = new Y.Array();
+        view.set(YjsDatabaseKey.field_orders, orders);
+      }
+
+      orders.push([{ id: fieldId }]);
+
+      let settings = view.get(YjsDatabaseKey.field_settings);
+
+      if (!settings) {
+        settings = new Y.Map() as typeof settings;
+        view.set(YjsDatabaseKey.field_settings, settings);
+      }
+
+      const setting = new Y.Map<unknown>();
+      const isGrid = Number(view.get(YjsDatabaseKey.layout)) === DatabaseViewLayout.Grid;
+
+      settings.set(fieldId, setting as never);
+      // collab-database default_field_visibility(): Grid AlwaysShown, else HideWhenEmpty.
+      setting.set(YjsDatabaseKey.visibility, isGrid ? 0 : 1);
+      setting.set(YjsDatabaseKey.width, DEFAULT_FIELD_WIDTH);
+      setting.set(YjsDatabaseKey.wrap, true);
+    });
+
+    const field = new Y.Map<unknown>();
+
+    fields.set(fieldId, field as YDatabaseField);
+    field.set(YjsDatabaseKey.id, fieldId);
+    field.set(YjsDatabaseKey.name, name);
+    field.set(YjsDatabaseKey.icon, '');
+    field.set(YjsDatabaseKey.type, type);
+    field.set(YjsDatabaseKey.is_primary, false);
+    field.set(YjsDatabaseKey.created_at, nowSeconds());
+    field.set(YjsDatabaseKey.last_modified, nowSeconds());
+
+    const typeOptions = new Y.Map<unknown>();
+    const typeOption = new Y.Map<unknown>();
+
+    field.set(YjsDatabaseKey.type_option, typeOptions);
+    typeOptions.set(String(type), typeOption);
+    Object.entries(defaultTypeOption(type)).forEach(([key, value]) => typeOption.set(key, value));
+  });
+
+  return fieldId;
+}
+
+export function renameField (databaseDoc: YDoc, fieldId: string, name: string) {
+  const field = getField(getDatabase(databaseDoc), fieldId);
+
+  databaseDoc.transact(() => {
+    field.set(YjsDatabaseKey.name, name);
+    field.set(YjsDatabaseKey.last_modified, nowSeconds());
+  });
+}
+
+export type FieldDeleteBlocker = 'primary' | 'group' | 'calendar' | null;
+
+// The web cannot re-group a board or re-assign a calendar's date property, so
+// properties that a view depends on are not deleted here.
+export function getFieldDeleteBlocker (database: YDatabase | undefined, fieldId: string): FieldDeleteBlocker {
+  if (!database) return null;
+  if (database.get(YjsDatabaseKey.fields)?.get(fieldId)?.get(YjsDatabaseKey.is_primary)) return 'primary';
+
+  let blocker: FieldDeleteBlocker = null;
+
+  database.get(YjsDatabaseKey.views)?.forEach((view) => {
+    if (blocker) return;
+    if (view.get(YjsDatabaseKey.groups)?.toArray().some((group) => fieldIdOf(group) === fieldId)) {
+      blocker = 'group';
+    } else if (view.get(YjsDatabaseKey.layout_settings)?.get('2')?.get(YjsDatabaseKey.field_id) === fieldId) {
+      blocker = 'calendar';
+    }
+  });
+  return blocker;
+}
+
+export function deleteField (databaseDoc: YDoc, fieldId: string) {
+  const database = getDatabase(databaseDoc);
+
+  if (getFieldDeleteBlocker(database, fieldId)) throw new Error('This property cannot be deleted');
+
+  databaseDoc.transact(() => {
+    database.get(YjsDatabaseKey.views).forEach((view) => {
+      removeWhere(view.get(YjsDatabaseKey.field_orders), (item) => (item as { id?: string } | null)?.id === fieldId);
+      view.get(YjsDatabaseKey.field_settings)?.delete(fieldId);
+      // Rust leaves these behind; the web would fail on a filter or sort whose
+      // property is gone.
+      removeWhere(view.get(YjsDatabaseKey.filters) as Y.Array<unknown>, (item) => fieldIdOf(item) === fieldId);
+      removeWhere(view.get(YjsDatabaseKey.sorts) as Y.Array<unknown>, (item) => fieldIdOf(item) === fieldId);
+      removeWhere(view.get(YjsDatabaseKey.calculations) as Y.Array<unknown>, (item) => fieldIdOf(item) === fieldId);
+    });
+    // Row cells stay, like on desktop.
+    database.get(YjsDatabaseKey.fields).delete(fieldId);
+  });
+}
+
+// Adds an option to a single/multi select property (or returns the existing
+// option with that name). Boards grouped by the property get a column for it.
+export function addSelectOption (databaseDoc: YDoc, fieldId: string, name: string): SelectOption {
+  const database = getDatabase(databaseDoc);
+  const field = getField(database, fieldId);
+  const type = Number(field.get(YjsDatabaseKey.type));
+  let typeOptions = field.get(YjsDatabaseKey.type_option) as Y.Map<unknown> | undefined;
+  let typeOption = typeOptions?.get(String(type)) as Y.Map<unknown> | undefined;
+  let content: SelectTypeOption = { options: [], disable_color: false };
+
+  try {
+    const parsed = JSON.parse((typeOption?.get(YjsDatabaseKey.content) as string) || '{}');
+
+    content = { options: parsed.options ?? [], disable_color: parsed.disable_color ?? false };
+  } catch (e) {
+    // keep the empty default
+  }
+
+  const existing = content.options.find((option) => option.name === name);
+
+  if (existing) return existing;
+
+  const ids = new Set(content.options.map((option) => option.id));
+  let id = nanoid(4);
+
+  while (ids.has(id)) id = nanoid(4);
+
+  const option: SelectOption = {
+    id,
+    name,
+    color: OPTION_COLORS[content.options.length % OPTION_COLORS.length],
+  };
+
+  databaseDoc.transact(() => {
+    if (!typeOptions) {
+      typeOptions = new Y.Map();
+      field.set(YjsDatabaseKey.type_option, typeOptions);
+    }
+
+    if (!typeOption) {
+      typeOption = new Y.Map();
+      typeOptions.set(String(type), typeOption);
+    }
+
+    typeOption.set(YjsDatabaseKey.content, JSON.stringify({ ...content, options: [...content.options, option] }));
+    field.set(YjsDatabaseKey.last_modified, nowSeconds());
+
+    database.get(YjsDatabaseKey.views).forEach((view) => {
+      view.get(YjsDatabaseKey.groups)?.forEach((group) => {
+        if (fieldIdOf(group) !== fieldId) return;
+        const columns = group.get(YjsDatabaseKey.groups) as Y.Array<unknown> | undefined;
+
+        if (!columns) return;
+        const known = (columns.toJSON() as { id: string }[]).some((column) => column.id === id);
+
+        if (!known) columns.push([{ id, visible: true }]);
+      });
+    });
+  });
+
+  return option;
+}
+
+export function useFieldEditActions () {
+  const { databaseDoc, canEditRows } = useDatabaseContext();
+
+  const run = useCallback(<T, >(action: () => T): T | undefined => {
+    if (!canEditRows) return;
+    try {
+      return action();
+      // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    } catch (e: any) {
+      console.error(e);
+      notify.error(e?.message || String(e));
+    }
+  }, [canEditRows]);
+
+  const create = useCallback((name: string, type: FieldType) => run(() => createField(databaseDoc, name, type)), [databaseDoc, run]);
+  const rename = useCallback((fieldId: string, name: string) => run(() => renameField(databaseDoc, fieldId, name)), [databaseDoc, run]);
+  const remove = useCallback((fieldId: string) => run(() => deleteField(databaseDoc, fieldId)), [databaseDoc, run]);
+  const addOption = useCallback((fieldId: string, name: string) => run(() => addSelectOption(databaseDoc, fieldId, name)), [databaseDoc, run]);
+
+  return {
+    canEditFields: !!canEditRows,
+    createField: create,
+    renameField: rename,
+    deleteField: remove,
+    addSelectOption: addOption,
+  };
+}
