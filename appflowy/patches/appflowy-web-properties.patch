+// Added by the AppFlowy Home Assistant add-on: a counter that changes when a
+// cell of one of the rows changes (e.g. edited on the row page), so boards and
+// calendars re-place the card or event.
+function useRowCellsVersion (rowOrders?: Row[], rows?: Record<RowId, YDoc> | null) {
+  const [version, setVersion] = useState(0);
+
+  useEffect(() => {
+    if (!rowOrders || !rows) return;
+    const onChange = debounce(() => setVersion((prev) => prev + 1), 200);
+    const maps = rowOrders
+      .map((row) => rows[row.id])
+      .filter((doc) => doc?.share.has(YjsEditorKey.data_section))
+      .map((doc) => doc.getMap(YjsEditorKey.data_section) as Y.Map<unknown>);
+
+    maps.forEach((map) => map.observeDeep(onChange));
+    return () => {
+      onChange.cancel();
+      maps.forEach((map) => map.unobserveDeep(onChange));
+    };
+  }, [rowOrders, rows]);
+
+  return version;
+}
