+// Added by the AppFlowy Home Assistant add-on: a plain single-line input for the
+// row page editors. Enter or blur commits, Escape cancels.
+import React, { useRef, useState } from 'react';
+
+export function InlineInput ({
+  value,
+  onCommit,
+  onCancel,
+  placeholder,
+  type = 'text',
+  inputMode,
+}: {
+  value: string;
+  onCommit: (value: string) => void;
+  onCancel: () => void;
+  placeholder?: string;
+  type?: string;
+  inputMode?: React.HTMLAttributes<HTMLInputElement>['inputMode'];
+}) {
+  const [text, setText] = useState(value);
+  const done = useRef(false);
+
+  const finish = (commit: boolean) => {
+    if (done.current) return;
+    done.current = true;
+    if (commit) onCommit(text.trim());
+    else onCancel();
+  };
+
+  return (
+    <input
+      autoFocus
+      type={type}
+      inputMode={inputMode}
+      value={text}
+      placeholder={placeholder}
+      className={'w-full min-w-0 bg-transparent outline-none'}
+      onChange={(e) => setText(e.target.value)}
+      onKeyDown={(e) => {
+        e.stopPropagation();
+        if (e.key === 'Enter') {
+          e.preventDefault();
+          finish(true);
+        } else if (e.key === 'Escape') {
+          e.preventDefault();
+          finish(false);
+        }
+      }}
+      onBlur={() => finish(true)}
+    />
+  );
+}
+
+export default InlineInput;
