+// Added by the AppFlowy Home Assistant add-on: picks the date (and optionally
+// the time) of a Date property on the row page. Native inputs, so phones show
+// their own date and time pickers. Dates are stored in local time, like the
+// desktop app does.
+import { FieldType } from '@/application/database-yjs';
+import { CellProps, DateTimeCell as DateTimeCellType } from '@/application/database-yjs/cell.type';
+import { updateDateCell } from '@/application/database-yjs/row-write';
+import { DateTimeCell } from '@/components/database/components/cell/date';
+import EditorPopup from '@/components/database/components/property/editable/EditorPopup';
+import { useCellWriter } from '@/components/database/components/property/editable/useCellWriter';
+import { Button, FormControlLabel, Switch } from '@mui/material';
+import dayjs from 'dayjs';
+import React, { useMemo, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+
+const inputClass = 'w-full rounded-[8px] border border-line-divider bg-transparent px-2 py-1.5 text-sm outline-none focus:border-fill-default';
+
+export function DateEditor (props: CellProps<DateTimeCellType>) {
+  const { cell, fieldId, rowId, placeholder, style } = props;
+  const { t } = useTranslation();
+  const { write } = useCellWriter(rowId);
+  const [anchorEl, setAnchorEl] = useState<HTMLElement | null>(null);
+  const isDate = cell?.fieldType === FieldType.DateTime;
+  const includeTime = isDate ? Boolean(cell.includeTime) : false;
+
+  const current = useMemo(() => {
+    if (!isDate || !cell.data) return null;
+    const value = dayjs.unix(Number(cell.data));
+
+    return value.isValid() ? value : null;
+  }, [cell, isDate]);
+
+  const date = current ? current.format('YYYY-MM-DD') : '';
+  const time = current ? current.format('HH:mm') : '';
+
+  const save = (nextDate: string, nextTime: string, nextIncludeTime: boolean) => {
+    if (!nextDate) return;
+    const value = dayjs(`${nextDate}T${nextIncludeTime && nextTime ? nextTime : '00:00'}:00`);
+
+    if (!value.isValid()) return;
+    write((rowDoc) => updateDateCell(rowDoc, fieldId, value.unix(), nextIncludeTime));
+  };
+
+  return (
+    <>
+      <div
+        className={'min-h-[24px] w-full min-w-0 cursor-pointer'}
+        onClick={(e) => setAnchorEl(e.currentTarget)}
+      >
+        {current ? <DateTimeCell {...props} /> : <div style={style} className={'text-text-placeholder'}>{placeholder}</div>}
+      </div>
+      <EditorPopup open={Boolean(anchorEl)} anchorEl={anchorEl} onClose={() => setAnchorEl(null)}>
+        <input
+          type={'date'}
+          className={inputClass}
+          value={date}
+          onChange={(e) => save(e.target.value, time || dayjs().format('HH:mm'), includeTime)}
+        />
+        <FormControlLabel
+          className={'m-0 justify-between'}
+          labelPlacement={'start'}
+          label={<span className={'text-sm'}>{t('grid.field.includeTime')}</span>}
+          control={(
+            <Switch
+              size={'small'}
+              checked={includeTime}
+              disabled={!date}
+              onChange={(e) => save(date, time || dayjs().format('HH:mm'), e.target.checked)}
+            />
+          )}
+        />
+        {includeTime && (
+          <input
+            type={'time'}
+            className={inputClass}
+            value={time}
+            onChange={(e) => save(date, e.target.value, true)}
+          />
+        )}
+        <div className={'flex justify-between gap-2'}>
+          <Button
+            size={'small'}
+            color={'inherit'}
+            disabled={!current}
+            onClick={() => {
+              write((rowDoc) => updateDateCell(rowDoc, fieldId, null, false));
+              setAnchorEl(null);
+            }}
+          >
+            {t('grid.field.clearDate')}
+          </Button>
+          <Button size={'small'} variant={'contained'} onClick={() => setAnchorEl(null)}>
+            {t('button.done')}
+          </Button>
+        </div>
+      </EditorPopup>
+    </>
+  );
+}
+
+export default DateEditor;
