+// Added by the AppFlowy Home Assistant add-on: "New property" on the row page
+// (grid row, board card, calendar event). The property is added to every view
+// of the database, like on desktop.
+import { EDITABLE_FIELD_TYPES, FieldType, useFieldEditActions } from '@/application/database-yjs';
+import { ReactComponent as AddIcon } from '@/assets/icons/plus.svg';
+import { NormalModal } from '@/components/_shared/modal';
+import { FieldTypeIcon } from '@/components/database/components/field/FieldTypeIcon';
+import { Button, TextField } from '@mui/material';
+import React, { useState } from 'react';
+import { useTranslation } from 'react-i18next';
+
+export function AddPropertyButton () {
+  const { t } = useTranslation();
+  const { canEditFields, createField } = useFieldEditActions();
+  const [open, setOpen] = useState(false);
+  const [type, setType] = useState<FieldType>(FieldType.Checklist);
+  const [name, setName] = useState('');
+
+  if (!canEditFields) return null;
+
+  const typeName = (fieldType: FieldType): string => {
+    switch (fieldType) {
+      case FieldType.RichText:
+        return t('grid.field.textFieldName');
+      case FieldType.Number:
+        return t('grid.field.numberFieldName');
+      case FieldType.DateTime:
+        return t('grid.field.dateFieldName');
+      case FieldType.SingleSelect:
+        return t('grid.field.singleSelectFieldName');
+      case FieldType.MultiSelect:
+        return t('grid.field.multiSelectFieldName');
+      case FieldType.Checkbox:
+        return t('grid.field.checkboxFieldName');
+      case FieldType.URL:
+        return t('grid.field.urlFieldName');
+      case FieldType.Checklist:
+        return t('grid.field.checklistFieldName');
+      default:
+        return '';
+    }
+  };
+
+  const close = () => {
+    setOpen(false);
+    setName('');
+  };
+
+  return (
+    <>
+      <Button
+        size={'small'}
+        color={'inherit'}
+        startIcon={<AddIcon className={'h-4 w-4'} />}
+        className={'w-fit justify-start text-xs font-normal text-text-caption hover:text-text-title'}
+        onClick={() => setOpen(true)}
+      >
+        {t('grid.field.newProperty')}
+      </Button>
+      <NormalModal
+        open={open}
+        title={t('grid.field.newProperty')}
+        okText={t('button.create')}
+        onClose={close}
+        onCancel={close}
+        onOk={() => {
+          createField(name.trim() || typeName(type), type);
+          close();
+        }}
+        classes={{ container: 'items-start max-md:mt-auto max-md:items-center mt-[10%] ' }}
+      >
+        <div className={'flex min-w-[260px] flex-col gap-4'}>
+          <TextField
+            autoFocus
+            fullWidth
+            size={'small'}
+            label={t('web.propertyName')}
+            placeholder={typeName(type)}
+            value={name}
+            onChange={(e) => setName(e.target.value)}
+          />
+          <div className={'flex flex-col gap-2'}>
+            <div className={'text-sm text-text-caption'}>{t('grid.field.propertyType')}</div>
+            <div className={'grid grid-cols-2 gap-2 sm:grid-cols-4'}>
+              {EDITABLE_FIELD_TYPES.map((fieldType) => (
+                <Button
+                  key={fieldType}
+                  size={'small'}
+                  color={'inherit'}
+                  variant={'outlined'}
+                  onClick={() => setType(fieldType)}
+                  startIcon={<FieldTypeIcon type={fieldType} className={'h-4 w-4'} />}
+                  className={`justify-start text-sm font-normal ${fieldType === type ? 'border-fill-default bg-fill-list-active' : 'border-line-divider'}`}
+                >
+                  <span className={'truncate'}>{typeName(fieldType)}</span>
+                </Button>
+              ))}
+            </div>
+          </div>
+        </div>
+      </NormalModal>
+    </>
+  );
+}
+
+export default AddPropertyButton;
