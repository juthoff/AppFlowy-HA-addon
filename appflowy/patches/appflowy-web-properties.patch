+// Added by the AppFlowy Home Assistant add-on: chooses the options of a Single or
+// Multi select property on the row page and creates new ones. Renaming,
+// recoloring and deleting options stays in the desktop app.
+import {
+  FieldType,
+  parseSelectOptionTypeOptions,
+  SelectOption,
+  useFieldEditActions,
+  useFieldSelector,
+} from '@/application/database-yjs';
+import { CellProps, SelectOptionCell as SelectOptionCellType } from '@/application/database-yjs/cell.type';
+import { updateSelectCell } from '@/application/database-yjs/row-write';
+import { YjsDatabaseKey } from '@/application/types';
+import { ReactComponent as CheckIcon } from '@/assets/icons/tick.svg';
+import { ReactComponent as AddIcon } from '@/assets/icons/plus.svg';
+import { Tag } from '@/components/_shared/tag';
+import { SelectOptionColorMap } from '@/components/database/components/cell/cell.const';
+import { SelectOptionCell } from '@/components/database/components/cell/select-option';
+import EditorPopup from '@/components/database/components/property/editable/EditorPopup';
+import { useCellWriter } from '@/components/database/components/property/editable/useCellWriter';
+import { getPlatform } from '@/utils/platform';
+import React, { useMemo, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+
+export function SelectEditor (props: CellProps<SelectOptionCellType>) {
+  const { cell, fieldId, rowId, placeholder, style } = props;
+  const { t } = useTranslation();
+  const { write } = useCellWriter(rowId);
+  const { addSelectOption } = useFieldEditActions();
+  const { field, clock } = useFieldSelector(fieldId);
+  const [anchorEl, setAnchorEl] = useState<HTMLElement | null>(null);
+  const [search, setSearch] = useState('');
+  const fieldType = Number(field?.get(YjsDatabaseKey.type)) as FieldType;
+  const isMulti = fieldType === FieldType.MultiSelect;
+
+  const options = useMemo(() => {
+    if (!field) return [];
+    return parseSelectOptionTypeOptions(field)?.options ?? [];
+    // clock: the options live inside the field's type option
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [field, clock]);
+
+  const selectedIds = useMemo(() => {
+    const data = cell?.fieldType === fieldType ? cell?.data : '';
+
+    return typeof data === 'string' && data ? data.split(',').filter((id) => options.some((o) => o.id === id)) : [];
+  }, [cell, fieldType, options]);
+
+  const query = search.trim();
+  const filtered = options.filter((option) => option.name.toLowerCase().includes(query.toLowerCase()));
+  const canCreate = query !== '' && !options.some((option) => option.name === query);
+
+  const choose = (option: SelectOption) => {
+    const selected = selectedIds.includes(option.id);
+    let next: string[];
+
+    if (isMulti) {
+      next = selected ? selectedIds.filter((id) => id !== option.id) : [...selectedIds, option.id];
+    } else {
+      next = selected ? [] : [option.id];
+      setAnchorEl(null);
+    }
+
+    setSearch('');
+    write((rowDoc) => updateSelectCell(rowDoc, fieldId, fieldType, next));
+  };
+
+  const create = () => {
+    const option = addSelectOption(fieldId, query);
+
+    if (option) choose(option);
+  };
+
+  return (
+    <>
+      <div
+        className={'min-h-[24px] w-full min-w-0 cursor-pointer'}
+        onClick={(e) => setAnchorEl(e.currentTarget)}
+      >
+        {selectedIds.length ? <SelectOptionCell {...props} /> : <div style={style} className={'text-text-placeholder'}>{placeholder}</div>}
+      </div>
+      <EditorPopup
+        open={Boolean(anchorEl)}
+        anchorEl={anchorEl}
+        onClose={() => {
+          setAnchorEl(null);
+          setSearch('');
+        }}
+      >
+        <input
+          autoFocus={!getPlatform().isMobile}
+          value={search}
+          placeholder={t('grid.selectOption.searchOrCreateOption')}
+          className={'w-full rounded-[8px] border border-line-divider bg-transparent px-2 py-1.5 text-sm outline-none focus:border-fill-default'}
+          onChange={(e) => setSearch(e.target.value)}
+          onKeyDown={(e) => {
+            e.stopPropagation();
+            if (e.key !== 'Enter') return;
+            e.preventDefault();
+            const exact = options.find((option) => option.name === query);
+
+            if (exact) choose(exact);
+            else if (canCreate) create();
+          }}
+        />
+        <div className={'flex max-h-[300px] flex-col gap-1 overflow-y-auto'}>
+          {filtered.map((option) => (
+            <button
+              key={option.id}
+              type={'button'}
+              className={'flex min-h-[32px] items-center justify-between gap-2 rounded-[6px] px-1 text-left hover:bg-fill-list-hover'}
+              onClick={() => choose(option)}
+            >
+              <Tag size={'small'} label={option.name} color={SelectOptionColorMap[option.color]} />
+              {selectedIds.includes(option.id) && <CheckIcon className={'h-4 w-4 shrink-0'} />}
+            </button>
+          ))}
+          {canCreate && (
+            <button
+              type={'button'}
+              className={'flex min-h-[32px] items-center gap-2 rounded-[6px] px-1 text-left text-sm hover:bg-fill-list-hover'}
+              onClick={create}
+            >
+              <AddIcon className={'h-4 w-4 shrink-0'} />
+              <span className={'truncate'}>{t('button.create')} &quot;{query}&quot;</span>
+            </button>
+          )}
+        </div>
+      </EditorPopup>
+    </>
+  );
+}
+
+export default SelectEditor;
