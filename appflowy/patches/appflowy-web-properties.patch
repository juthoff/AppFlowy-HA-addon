@@ -0,0 +1,156 @@
+// Added by the AppFlowy Home Assistant add-on: row page editors for Text, Number,
+// URL and Checkbox properties (upstream v0.1.18 only displays them).
+import { FieldType } from '@/application/database-yjs';
+import {
+  CellProps,
+  CheckboxCell as CheckboxCellType,
+  NumberCell as NumberCellType,
+  TextCell as TextCellType,
+  UrlCell as UrlCellType,
+} from '@/application/database-yjs/cell.type';
+import { updateCheckboxCell, updateRowCell } from '@/application/database-yjs/row-write';
+import { ReactComponent as CheckboxCheckSvg } from '@/assets/icons/check_filled.svg';
+import { ReactComponent as CheckboxUncheckSvg } from '@/assets/icons/uncheck.svg';
+import { ReactComponent as EditSvg } from '@/assets/icons/edit.svg';
+import { notify } from '@/components/_shared/notify';
+import ReferenceInput from '@/components/_shared/reference/ReferenceInput';
+import { NumberCell } from '@/components/database/components/cell/number';
+import { TextCell } from '@/components/database/components/cell/text';
+import { UrlCell } from '@/components/database/components/cell/url';
+import InlineInput from '@/components/database/components/property/editable/InlineInput';
+import { useCellWriter } from '@/components/database/components/property/editable/useCellWriter';
+import { IconButton } from '@mui/material';
+import React, { useState } from 'react';
+import { useTranslation } from 'react-i18next';
+
+const clickArea = 'min-h-[24px] w-full min-w-0 cursor-text';
+
+export function TextEditor (props: CellProps<TextCellType>) {
+  const { cell, fieldId, rowId, placeholder } = props;
+  const { write } = useCellWriter(rowId);
+  const [editing, setEditing] = useState(false);
+  const value = cell?.fieldType === FieldType.RichText ? cell.data || '' : '';
+
+  if (editing) {
+    return (
+      <div className={'w-full text-xs'}>
+        <ReferenceInput
+          value={value}
+          placeholder={placeholder}
+          onCancel={() => setEditing(false)}
+          onCommit={(text) => {
+            setEditing(false);
+            if (text !== value) write((rowDoc) => updateRowCell(rowDoc, fieldId, FieldType.RichText, text));
+          }}
+        />
+      </div>
+    );
+  }
+
+  return (
+    <div className={clickArea} onClick={() => setEditing(true)}>
+      <TextCell {...props} />
+    </div>
+  );
+}
+
+// Accepts "1,5" as well as "1.5"; "" clears the value.
+function normalizeNumber (text: string) {
+  const value = text.replace(/\s/g, '').replace(',', '.');
+
+  if (value === '') return '';
+  if (!/^[-+]?(\d+\.?\d*|\.\d+)(e[-+]?\d+)?$/i.test(value)) return null;
+  return String(Number(value));
+}
+
+export function NumberEditor (props: CellProps<NumberCellType>) {
+  const { cell, fieldId, rowId, placeholder, style } = props;
+  const { t } = useTranslation();
+  const { write } = useCellWriter(rowId);
+  const [editing, setEditing] = useState(false);
+  const value = cell?.fieldType === FieldType.Number ? cell.data || '' : '';
+
+  if (editing) {
+    return (
+      <div className={'w-full text-xs'}>
+        <InlineInput
+          value={value}
+          inputMode={'decimal'}
+          placeholder={placeholder}
+          onCancel={() => setEditing(false)}
+          onCommit={(text) => {
+            setEditing(false);
+            const number = normalizeNumber(text);
+
+            if (number === null) {
+              notify.error(t('web.invalidNumber'));
+              return;
+            }
+
+            if (number !== value) write((rowDoc) => updateRowCell(rowDoc, fieldId, FieldType.Number, number));
+          }}
+        />
+      </div>
+    );
+  }
+
+  return (
+    <div className={clickArea} onClick={() => setEditing(true)}>
+      {value ? <NumberCell {...props} /> : <div style={style} className={'text-text-placeholder'}>{placeholder}</div>}
+    </div>
+  );
+}
+
+export function UrlEditor (props: CellProps<UrlCellType>) {
+  const { cell, fieldId, rowId, placeholder } = props;
+  const { t } = useTranslation();
+  const { write } = useCellWriter(rowId);
+  const [editing, setEditing] = useState(false);
+  const value = cell?.fieldType === FieldType.URL ? cell.data || '' : '';
+
+  if (editing) {
+    return (
+      <div className={'w-full text-xs'}>
+        <InlineInput
+          value={value}
+          type={'url'}
+          inputMode={'url'}
+          placeholder={placeholder}
+          onCancel={() => setEditing(false)}
+          onCommit={(text) => {
+            setEditing(false);
+            if (text !== value) write((rowDoc) => updateRowCell(rowDoc, fieldId, FieldType.URL, text));
+          }}
+        />
+      </div>
+    );
+  }
+
+  // Tapping a link opens it, so editing has its own (always visible) button.
+  return (
+    <div className={'flex w-full min-w-0 items-center gap-1'}>
+      <div className={`relative flex-1 ${clickArea}`} onClick={() => !value && setEditing(true)}>
+        <UrlCell {...props} />
+      </div>
+      <IconButton size={'small'} title={t('button.edit')} onClick={() => setEditing(true)}>
+        <EditSvg className={'h-4 w-4'} />
+      </IconButton>
+    </div>
+  );
+}
+
+export function CheckboxEditor ({ cell, fieldId, rowId }: CellProps<CheckboxCellType>) {
+  const { write } = useCellWriter(rowId);
+  const checked = cell?.fieldType === FieldType.Checkbox && Boolean(cell.data);
+  const Icon = checked ? CheckboxCheckSvg : CheckboxUncheckSvg;
+
+  return (
+    <button
+      type={'button'}
+      className={'flex h-6 w-6 items-center justify-center text-fill-default'}
+      onClick={() => write((rowDoc) => updateCheckboxCell(rowDoc, fieldId, !checked))}
+    >
+      <Icon className={'h-5 w-5'} />
+    </button>
+  );
+}
diff --git a/src/components/database/components/property/editable/useCellWriter.ts b/src/components/database/components/property/editable/useCellWriter.ts
new file mode 100644
index 0000000..077e5eb
--- /dev/null
+++ b/src/components/database/components/property/editable/useCellWriter.ts
@@ -0,0 +1,24 @@
+// Added by the AppFlowy Home Assistant add-on: shared by the row page editors.
+import { useRowDocMap, useRowReadOnly } from '@/application/database-yjs';
+import { YDoc } from '@/application/types';
+import { notify } from '@/components/_shared/notify';
+import { useCallback } from 'react';
+
+export function useCellWriter (rowId: string) {
+  const readOnly = useRowReadOnly();
+  const rowDoc = useRowDocMap()?.[rowId];
+  const editable = !readOnly && Boolean(rowDoc);
+
+  const write = useCallback((change: (rowDoc: YDoc) => void) => {
+    if (!rowDoc || readOnly) return;
+    try {
+      change(rowDoc);
+      // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    } catch (e: any) {
+      console.error(e);
+      notify.error(e?.message || String(e));
+    }
+  }, [readOnly, rowDoc]);
+
+  return { editable, write };
+}
