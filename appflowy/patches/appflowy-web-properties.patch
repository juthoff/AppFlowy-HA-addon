+// Added by the AppFlowy Home Assistant add-on: a popover next to the property
+// on desktop, a bottom sheet on phones (the row page is full-screen there).
+import { Popover } from '@/components/_shared/popover';
+import { getPlatform } from '@/utils/platform';
+import { Drawer } from '@mui/material';
+import React, { useMemo } from 'react';
+
+export function EditorPopup ({
+  open,
+  anchorEl,
+  onClose,
+  children,
+}: {
+  open: boolean;
+  anchorEl: HTMLElement | null;
+  onClose: () => void;
+  children: React.ReactNode;
+}) {
+  const isMobile = useMemo(() => getPlatform().isMobile, []);
+
+  if (!open) return null;
+
+  if (isMobile) {
+    return (
+      <Drawer
+        anchor={'bottom'}
+        open={open}
+        onClose={onClose}
+        PaperProps={{ className: 'rounded-t-[12px] max-h-[70vh]' }}
+      >
+        <div className={'flex flex-col gap-3 p-4 pb-8'}>{children}</div>
+      </Drawer>
+    );
+  }
+
+  return (
+    <Popover
+      open={open}
+      anchorEl={anchorEl}
+      onClose={onClose}
+      adjustOrigins
+    >
+      <div className={'flex w-[280px] max-w-[90vw] flex-col gap-3 p-3'}>{children}</div>
+    </Popover>
+  );
+}
+
+export default EditorPopup;
