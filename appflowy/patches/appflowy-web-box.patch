@@ -0,0 +1,86 @@
+// Added by the AppFlowy Home Assistant add-on: a box with an adjustable border
+// colour. The block's own text is the headline, its child blocks are the body.
+import { YjsEditor } from '@/application/slate-yjs';
+import { CustomEditor } from '@/application/slate-yjs/command';
+import { BlockType } from '@/application/types';
+import { ReactComponent as ColorIcon } from '@/assets/icons/text_color.svg';
+import { Popover } from '@/components/_shared/popover';
+import { BorderColorPalette, DEFAULT_BORDER_COLOR } from '@/components/editor/components/blocks/bordered-box/BorderColorPalette';
+import { BorderedBoxNode, EditorElementProps } from '@/components/editor/editor.type';
+import { renderColor } from '@/utils/color';
+import { Tooltip } from '@mui/material';
+import React, { forwardRef, memo, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { Element } from 'slate';
+import { useReadOnly, useSlateStatic } from 'slate-react';
+
+export const BorderedBox = memo(
+  forwardRef<HTMLDivElement, EditorElementProps<BorderedBoxNode>>(({ node, children, ...attributes }, ref) => {
+    const { t } = useTranslation();
+    const editor = useSlateStatic() as YjsEditor;
+    const blockId = node.blockId;
+    const borderColor = node.data?.border_color;
+    const readOnly = useReadOnly() || editor.isElementReadOnly(node as unknown as Element);
+    const [colorAnchor, setColorAnchor] = useState<HTMLElement | null>(null);
+    const hasBody = node.children.length > 1;
+
+    return (
+      <div
+        ref={ref}
+        {...attributes}
+        className={`${attributes.className ?? ''} bordered-box relative my-1 rounded-[8px] border-2 py-2 pl-3 pr-9`}
+        style={{
+          ...attributes.style,
+          borderColor: borderColor ? renderColor(borderColor) : DEFAULT_BORDER_COLOR,
+        }}
+      >
+        {children}
+        {!readOnly && !hasBody && (
+          <div
+            onMouseDown={(e) => {
+              e.preventDefault();
+              CustomEditor.addChildBlock(editor, blockId, BlockType.Paragraph, {});
+            }}
+            data-testid={'bordered-box-empty'}
+            contentEditable={false}
+            className={'flex h-[32px] cursor-pointer select-none items-center rounded-[6px] px-[0.5em] text-sm text-text-caption hover:bg-fill-list-hover'}
+          >
+            {t('web.boxAddText')}
+          </div>
+        )}
+        {!readOnly && (
+          <div contentEditable={false} className={'bordered-box-color absolute right-1.5 top-1.5 select-none'}>
+            <Tooltip disableInteractive={true} title={t('web.boxBorderColor')} placement={'top'}>
+              <button
+                type={'button'}
+                data-testid={'bordered-box-color'}
+                className={'flex h-6 w-6 items-center justify-center rounded-[6px] text-text-caption hover:bg-fill-list-hover'}
+                onMouseDown={(e) => {
+                  e.preventDefault();
+                  e.stopPropagation();
+                  setColorAnchor(e.currentTarget);
+                }}
+              >
+                <ColorIcon className={'h-4 w-4'} />
+              </button>
+            </Tooltip>
+            <Popover
+              open={Boolean(colorAnchor)}
+              anchorEl={colorAnchor}
+              onClose={() => setColorAnchor(null)}
+              disableRestoreFocus={true}
+              disableAutoFocus={true}
+              disableEnforceFocus={true}
+              anchorOrigin={{ vertical: 'bottom', horizontal: 'right' }}
+              transformOrigin={{ vertical: -4, horizontal: 'right' }}
+            >
+              <BorderColorPalette blockId={blockId} value={borderColor} onPicked={() => setColorAnchor(null)} />
+            </Popover>
+          </div>
+        )}
+      </div>
+    );
+  }),
+);
+
+export default BorderedBox;
