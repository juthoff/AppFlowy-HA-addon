+// Added by the AppFlowy Home Assistant add-on: border colour swatches for the
+// bordered box block. Uses the editor's text colours, which stay visible as a
+// line in light and dark theme (the background tints are too pale for that).
+import { YjsEditor } from '@/application/slate-yjs';
+import { CustomEditor } from '@/application/slate-yjs/command';
+import { BorderedBoxBlockData } from '@/application/types';
+import { Tooltip } from '@mui/material';
+import React, { useMemo } from 'react';
+import { useTranslation } from 'react-i18next';
+import { useSlateStatic } from 'slate-react';
+
+export const DEFAULT_BORDER_COLOR = 'var(--line-border)';
+
+export function BorderColorPalette ({ blockId, value, onPicked }: {
+  blockId: string;
+  value?: string;
+  onPicked?: () => void;
+}) {
+  const { t } = useTranslation();
+  const editor = useSlateStatic() as YjsEditor;
+
+  const colors = useMemo(() => [
+    { label: t('editor.fontColorDefault'), color: '' },
+    { label: t('editor.fontColorGray'), color: 'rgb(120, 119, 116)' },
+    { label: t('editor.fontColorBrown'), color: 'rgb(159, 107, 83)' },
+    { label: t('editor.fontColorOrange'), color: 'rgb(217, 115, 13)' },
+    { label: t('editor.fontColorYellow'), color: 'rgb(203, 145, 47)' },
+    { label: t('editor.fontColorGreen'), color: 'rgb(68, 131, 97)' },
+    { label: t('editor.fontColorBlue'), color: 'rgb(51, 126, 169)' },
+    { label: t('editor.fontColorPurple'), color: 'rgb(144, 101, 176)' },
+    { label: t('editor.fontColorPink'), color: 'rgb(193, 76, 138)' },
+    { label: t('editor.fontColorRed'), color: 'rgb(212, 76, 71)' },
+  ], [t]);
+
+  return (
+    <div className={'flex w-[200px] flex-col gap-2 p-3'}>
+      <div className={'text-xs text-text-caption'}>{t('web.boxBorderColor')}</div>
+      <div className={'flex flex-wrap gap-1.5'}>
+        {colors.map(({ label, color }) => (
+          <Tooltip disableInteractive={true} key={label} title={label} placement={'top'}>
+            <div
+              data-testid={`box-border-color-${color || 'default'}`}
+              className={'h-6 w-6 cursor-pointer rounded-[6px] border-2 p-[2px]'}
+              style={{ borderColor: (value || '') === color ? 'var(--fill-default)' : 'transparent' }}
+              onMouseDown={(e) => e.preventDefault()}
+              onClick={() => {
+                CustomEditor.setBlockData<BorderedBoxBlockData>(editor, blockId, { border_color: color || undefined });
+                onPicked?.();
+              }}
+            >
+              <div
+                className={'h-full w-full rounded-[4px] border-2 hover:opacity-70'}
+                style={{ borderColor: color || DEFAULT_BORDER_COLOR }}
+              />
+            </div>
+          </Tooltip>
+        ))}
+      </div>
+    </div>
+  );
+}
+
+export default BorderColorPalette;
diff --git a/src/components/editor/components/blocks/bordered-box/BorderedBox.tsx b/src/components/editor/components/blocks/bordered-box/BorderedBox.tsx
new file mode 100644
