+// Added by the AppFlowy Home Assistant add-on: "Border colour" entry in the
+// block menu of a bordered box (same layout as the outline's Depth entry).
+import { ReactComponent as ColorIcon } from '@/assets/icons/text_color.svg';
+import { Origins, Popover } from '@/components/_shared/popover';
+import { BorderColorPalette } from '@/components/editor/components/blocks/bordered-box/BorderColorPalette';
+import { BorderedBoxNode } from '@/components/editor/editor.type';
+import { Button, Divider } from '@mui/material';
+import React, { useRef, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+
+const origins: Origins = {
+  anchorOrigin: {
+    vertical: 'top',
+    horizontal: 'right',
+  },
+  transformOrigin: {
+    vertical: 'top',
+    horizontal: -16,
+  },
+};
+
+function BorderColorMenuItem ({ node, onPicked }: { node: BorderedBoxNode; onPicked: () => void }) {
+  const [open, setOpen] = useState(false);
+  const ref = useRef<HTMLButtonElement>(null);
+  const { t } = useTranslation();
+
+  return (
+    <>
+      <Divider />
+      <Button
+        ref={ref}
+        data-testid={'borderColor'}
+        startIcon={<ColorIcon />}
+        size={'small'}
+        color={'inherit'}
+        className={'justify-start'}
+        onClick={() => setOpen(true)}
+      >
+        {t('web.boxBorderColor')}
+      </Button>
+      <Popover open={open} anchorEl={ref.current} onClose={() => setOpen(false)} {...origins}>
+        <BorderColorPalette
+          blockId={node.blockId}
+          value={node.data?.border_color}
+          onPicked={() => {
+            setOpen(false);
+            onPicked();
+          }}
+        />
+      </Popover>
+    </>
+  );
+}
+
+export default BorderColorMenuItem;
