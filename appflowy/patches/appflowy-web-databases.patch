@@ -0,0 +1,48 @@
+// Added by the AppFlowy Home Assistant add-on: deletes the row shown on the row
+// page (grid row, board card or calendar event) from every view.
+import { useDatabaseContext, useRowEditActions } from '@/application/database-yjs';
+import { ReactComponent as DeleteIcon } from '@/assets/icons/delete.svg';
+import { NormalModal } from '@/components/_shared/modal';
+import { Button } from '@mui/material';
+import React, { useState } from 'react';
+import { useTranslation } from 'react-i18next';
+
+export function DeleteRowButton ({ rowId }: { rowId: string }) {
+  const { t } = useTranslation();
+  const { canEditRows, deleteRow } = useRowEditActions();
+  const { onCloseRow } = useDatabaseContext();
+  const [open, setOpen] = useState(false);
+
+  if (!canEditRows) return null;
+
+  return (
+    <>
+      <Button
+        size={'small'}
+        color={'inherit'}
+        startIcon={<DeleteIcon className={'h-4 w-4'} />}
+        className={'text-text-caption hover:text-function-error'}
+        onClick={() => setOpen(true)}
+      >
+        {t('grid.row.delete')}
+      </Button>
+      <NormalModal
+        open={open}
+        danger
+        title={t('grid.row.delete')}
+        okText={t('button.delete')}
+        onClose={() => setOpen(false)}
+        onCancel={() => setOpen(false)}
+        onOk={() => {
+          setOpen(false);
+          onCloseRow?.();
+          deleteRow(rowId);
+        }}
+      >
+        {t('grid.row.deleteRowPrompt')}
+      </NormalModal>
+    </>
+  );
+}
+
+export default DeleteRowButton;
