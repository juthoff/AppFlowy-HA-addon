diff --git a/src/application/database-yjs/row-create.ts b/src/application/database-yjs/row-create.ts
new file mode 100644
index 0000000..e927173
--- /dev/null
+++ b/src/application/database-yjs/row-create.ts
@@ -0,0 +1,154 @@
+// Added by the AppFlowy Home Assistant add-on (not part of upstream AppFlowy-Web
+// v0.1.18, which cannot add rows): creates and deletes database rows (grid rows,
+// board cards, calendar events) in the same shape AppFlowy-Collab's Rust code
+// uses (collab-database rows/row.rs, views/row_order.rs).
+//
+// - A row is its own collab (root "data" -> {data, meta, comment}). It is created
+//   on the server by its first web-update; nothing else has to be registered.
+// - The row becomes visible by pushing a plain {id, height} object into the
+//   row_orders of every view of the database. Deleting removes those entries
+//   (the row collab stays, like on desktop).
+// - Row created_at/last_modified are decimal strings: yrs reads a JS integer as
+//   Any::Number(f64), which Row's i64 deserializer rejects, so the whole row
+//   would fail to load on server and desktop. Strings are accepted explicitly.
+import { db } from '@/application/db';
+import { useDatabaseContext } from '@/application/database-yjs/context';
+import { FieldType } from '@/application/database-yjs/database.type';
+import { updateCollab } from '@/application/services/js-services/http/http_api';
+import { Types, YDatabase, YDoc, YjsDatabaseKey, YjsEditorKey } from '@/application/types';
+import { notify } from '@/components/_shared/notify';
+import { useCallback } from 'react';
+import { v4 as uuidv4 } from 'uuid';
+import * as Y from 'yjs';
+
+const DEFAULT_ROW_HEIGHT = 60;
+
+export interface InitialCell {
+  fieldId: string;
+  fieldType: FieldType;
+  data: string;
+  extra?: Record<string, unknown>;
+}
+
+export function initRowDoc (rowDoc: YDoc, rowId: string, databaseId: string, cells: InitialCell[] = []) {
+  const now = Math.floor(Date.now() / 1000);
+  const root = rowDoc.getMap(YjsEditorKey.data_section);
+
+  rowDoc.transact(() => {
+    const row = new Y.Map<unknown>();
+
+    root.set(YjsEditorKey.database_row, row);
+    root.set(YjsEditorKey.meta, new Y.Map());
+    root.set('comment', new Y.Array());
+
+    row.set(YjsDatabaseKey.id, rowId);
+    row.set(YjsDatabaseKey.database_id, databaseId);
+    row.set(YjsDatabaseKey.height, DEFAULT_ROW_HEIGHT);
+    row.set(YjsDatabaseKey.visibility, true);
+    row.set(YjsDatabaseKey.created_at, String(now));
+    row.set(YjsDatabaseKey.last_modified, String(now));
+
+    const cellMap = new Y.Map<unknown>();
+
+    row.set(YjsDatabaseKey.cells, cellMap);
+
+    for (const { fieldId, fieldType, data, extra } of cells) {
+      const cell = new Y.Map<unknown>();
+
+      cellMap.set(fieldId, cell);
+      cell.set(YjsDatabaseKey.field_type, fieldType);
+      cell.set(YjsDatabaseKey.data, data);
+      cell.set(YjsDatabaseKey.created_at, now);
+      cell.set(YjsDatabaseKey.last_modified, now);
+      Object.entries(extra ?? {}).forEach(([key, value]) => cell.set(key, value));
+    }
+  });
+}
+
+function getDatabase (databaseDoc: YDoc) {
+  return databaseDoc.getMap(YjsEditorKey.data_section).get(YjsEditorKey.database) as YDatabase | undefined;
+}
+
+export async function createDatabaseRow ({ databaseDoc, workspaceId, createRowDoc }: {
+  databaseDoc: YDoc;
+  workspaceId: string;
+  createRowDoc: (rowKey: string) => Promise<YDoc>;
+}, cells?: InitialCell[]) {
+  const database = getDatabase(databaseDoc);
+
+  if (!database) throw new Error('Database not loaded');
+
+  const databaseId = database.get(YjsDatabaseKey.id);
+  const rowId = uuidv4();
+  const rowKey = `${databaseDoc.guid}_rows_${rowId}`;
+  // Registers the row for syncing under its row id (see app.hooks createRowDoc).
+  const rowDoc = await createRowDoc(rowKey);
+
+  initRowDoc(rowDoc, rowId, databaseId, cells);
+
+  // The row must exist on the server before the database refers to it.
+  await updateCollab(workspaceId, rowId, Types.DatabaseRow, Y.encodeStateAsUpdate(rowDoc), { version_vector: 0 });
+  // Database.tsx only shows rows that have a local cache entry.
+  await db.rows.put({ row_id: rowId, row_key: rowKey, version: 1 });
+
+  databaseDoc.transact(() => {
+    database.get(YjsDatabaseKey.views).forEach((view) => {
+      view.get(YjsDatabaseKey.row_orders)?.push([{ id: rowId, height: DEFAULT_ROW_HEIGHT } as never]);
+    });
+  });
+
+  return rowId;
+}
+
+export function deleteDatabaseRow (databaseDoc: YDoc, rowId: string) {
+  const database = getDatabase(databaseDoc);
+
+  if (!database) throw new Error('Database not loaded');
+
+  databaseDoc.transact(() => {
+    database.get(YjsDatabaseKey.views).forEach((view) => {
+      const rowOrders = view.get(YjsDatabaseKey.row_orders);
+
+      if (!rowOrders) return;
+
+      const items = rowOrders.toJSON() as { id: string }[];
+
+      for (let i = items.length - 1; i >= 0; i--) {
+        if (items[i]?.id === rowId) rowOrders.delete(i, 1);
+      }
+    });
+  });
+}
+
+export function useRowEditActions () {
+  const { databaseDoc, workspaceId, createRowDoc, navigateToRow, canEditRows } = useDatabaseContext();
+
+  const createRow = useCallback(async (cells?: InitialCell[], open = true) => {
+    if (!canEditRows || !createRowDoc) return;
+
+    try {
+      const rowId = await createDatabaseRow({ databaseDoc, workspaceId, createRowDoc }, cells);
+
+      if (open) navigateToRow?.(rowId);
+      return rowId;
+      // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    } catch (e: any) {
+      console.error(e);
+      notify.error(e?.message || String(e));
+    }
+  }, [canEditRows, createRowDoc, databaseDoc, workspaceId, navigateToRow]);
+
+  const deleteRow = useCallback((rowId: string) => {
+    if (!canEditRows) return;
+
+    try {
+      deleteDatabaseRow(databaseDoc, rowId);
+      // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    } catch (e: any) {
+      console.error(e);
+      notify.error(e?.message || String(e));
+    }
+  }, [canEditRows, databaseDoc]);
+
+  return { canEditRows: !!canEditRows, createRow, deleteRow };
+}
