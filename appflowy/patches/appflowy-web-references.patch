@@ -0,0 +1,78 @@
+// Added by the AppFlowy Home Assistant add-on (not part of upstream AppFlowy-Web
+// v0.1.18): renders `[[Name|view-id]]` markers in plain-text names as page
+// references. Outside the app (published pages) there is no AppContext, so the
+// references degrade to their stored names.
+import { View, ViewLayout } from '@/application/types';
+import PageIcon from '@/components/_shared/view-icon/PageIcon';
+import { AppContext } from '@/components/app/app.hooks';
+import { parseReferences, plainName } from '@/utils/referenceMarker';
+import React, { useContext, useEffect, useMemo, useState } from 'react';
+
+export function ReferenceChip ({ name, viewId }: { name: string; viewId: string }) {
+  const context = useContext(AppContext);
+  const loadViewMeta = context?.loadViewMeta;
+  const toView = context?.toView;
+  const [meta, setMeta] = useState<View | null>(null);
+  const [noAccess, setNoAccess] = useState(false);
+
+  useEffect(() => {
+    if (!loadViewMeta) return;
+    let active = true;
+
+    setNoAccess(false);
+    loadViewMeta(viewId, (meta) => {
+      if (active) setMeta(meta);
+    }).then((meta) => {
+      if (active) setMeta(meta);
+    }).catch(() => {
+      if (active) setNoAccess(true);
+    });
+
+    return () => {
+      active = false;
+    };
+  }, [loadViewMeta, viewId]);
+
+  const label = (meta?.name && plainName(meta.name)) || name;
+
+  if (!context) return <span>{name}</span>;
+
+  return (
+    <span
+      data-reference-id={viewId}
+      contentEditable={false}
+      title={label}
+      onMouseDown={(e) => e.stopPropagation()}
+      onClick={(e) => {
+        e.preventDefault();
+        e.stopPropagation();
+        if (noAccess) return;
+        void toView?.(viewId);
+      }}
+      className={`inline-flex max-w-full items-baseline gap-1 align-baseline ${noAccess ? 'cursor-default text-text-caption line-through' : 'cursor-pointer underline hover:opacity-80'}`}
+      style={{ textUnderlinePosition: 'under' }}
+    >
+      <PageIcon
+        view={{ icon: meta?.icon, layout: meta?.layout ?? ViewLayout.Document }}
+        className={'flex h-[1em] w-[1em] shrink-0 items-center justify-center self-center'}
+      />
+      <span className={'truncate'}>{label}</span>
+    </span>
+  );
+}
+
+export function ReferenceText ({ text, placeholder }: { text?: string | null; placeholder?: React.ReactNode }) {
+  const segments = useMemo(() => parseReferences(text), [text]);
+
+  if (!segments.length) return <>{placeholder ?? null}</>;
+
+  return (
+    <>
+      {segments.map((segment, index) => segment.type === 'text'
+        ? <React.Fragment key={index}>{segment.text}</React.Fragment>
+        : <ReferenceChip key={index} name={segment.name} viewId={segment.viewId} />)}
+    </>
+  );
+}
+
+export default ReferenceText;
diff --git a/src/components/_shared/reference/useReferencePicker.tsx b/src/components/_shared/reference/useReferencePicker.tsx
new file mode 100644
index 0000000..2d515a8
--- /dev/null
+++ b/src/components/_shared/reference/useReferencePicker.tsx
@@ -0,0 +1,150 @@
+// Added by the AppFlowy Home Assistant add-on (not part of upstream AppFlowy-Web
+// v0.1.18): a page picker for plain-text inputs. Typing `[[` or `@` opens it;
+// choosing a page replaces the typed trigger with a `[[Name|view-id]]` marker.
+import { View } from '@/application/types';
+import { flattenViews } from '@/components/_shared/outline/utils';
+import PageIcon from '@/components/_shared/view-icon/PageIcon';
+import { AppContext } from '@/components/app/app.hooks';
+import { findReferenceQuery, makeMarker, plainName } from '@/utils/referenceMarker';
+import { Paper, Popper } from '@mui/material';
+import { sortBy, uniqBy } from 'lodash-es';
+import React, { useCallback, useContext, useEffect, useMemo, useRef, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+
+const MAX_RESULTS = 8;
+
+interface PickerState {
+  query: string;
+  start: number;
+  end: number;
+  anchor: HTMLElement;
+}
+
+export function useReferencePicker ({ onPick }: {
+  // Replace text[start, end) with the marker; the caller moves the caret after it.
+  onPick: (start: number, end: number, marker: string) => void;
+}) {
+  const { t } = useTranslation();
+  const loadViews = useContext(AppContext)?.loadViews;
+  const [state, setState] = useState<PickerState | null>(null);
+  const [views, setViews] = useState<View[]>([]);
+  const [selected, setSelected] = useState(0);
+  const open = Boolean(state && loadViews);
+
+  useEffect(() => {
+    if (!open || !loadViews) return;
+    let active = true;
+
+    void loadViews().then((views) => {
+      if (!active) return;
+      const pages = flattenViews(views || []).filter((view) => !view.extra?.is_space);
+
+      setViews(sortBy(uniqBy(pages, 'view_id'), 'last_edited_time').reverse());
+    }).catch(console.error);
+    return () => {
+      active = false;
+    };
+  }, [open, loadViews]);
+
+  const results = useMemo(() => {
+    const query = (state?.query || '').trim().toLowerCase();
+
+    return views
+      .filter((view) => !query || plainName(view.name).toLowerCase().includes(query))
+      .slice(0, MAX_RESULTS);
+  }, [views, state?.query]);
+
+  useEffect(() => {
+    setSelected(0);
+  }, [state?.query]);
+
+  // Call after every input / caret change with the input's text and caret offset.
+  const update = useCallback((text: string, caret: number, anchor: HTMLElement | null) => {
+    const found = anchor ? findReferenceQuery(text, caret) : null;
+
+    setState(found && anchor ? { query: found.query, start: found.start, end: found.end, anchor } : null);
+  }, []);
+
+  const close = useCallback(() => setState(null), []);
+
+  const stateRef = useRef(state);
+
+  stateRef.current = state;
+
+  const pick = useCallback((view: View) => {
+    const current = stateRef.current;
+
+    if (!current) return;
+    setState(null);
+    onPick(current.start, current.end, makeMarker(view.name || t('menuAppHeader.defaultNewPageName'), view.view_id));
+  }, [onPick, t]);
+
+  // Returns true when the key was handled by the picker.
+  const onKeyDown = useCallback((e: React.KeyboardEvent) => {
+    if (!open || !results.length) {
+      if (open && e.key === 'Escape') {
+        e.preventDefault();
+        setState(null);
+        return true;
+      }
+
+      return false;
+    }
+
+    switch (e.key) {
+      case 'ArrowDown':
+        e.preventDefault();
+        setSelected((i) => (i + 1) % results.length);
+        return true;
+      case 'ArrowUp':
+        e.preventDefault();
+        setSelected((i) => (i - 1 + results.length) % results.length);
+        return true;
+      case 'Enter':
+      case 'Tab':
+        e.preventDefault();
+        pick(results[selected] || results[0]);
+        return true;
+      case 'Escape':
+        e.preventDefault();
+        setState(null);
+        return true;
+      default:
+        return false;
+    }
+  }, [open, results, selected, pick]);
+
+  const element = (
+    <Popper
+      open={open}
+      anchorEl={state?.anchor}
+      placement={'bottom-start'}
