@@ -0,0 +1,81 @@
+// Added by the AppFlowy Home Assistant add-on (not part of upstream AppFlowy-Web
+// v0.1.18, which never writes database rows): cell and row-meta writes in the
+// same shape AppFlowy-Collab's Rust code uses, so the desktop app reads them.
+// Numbers are plain JS numbers; yrs decodes them as Any::Number, which its
+// i64 conversions accept just like Any::BigInt.
+import { FieldType, RowMetaKey } from '@/application/database-yjs/database.type';
+import { metaIdFromRowId } from '@/application/database-yjs/const';
+import { SelectOption } from '@/application/database-yjs/fields/select-option/select_option.type';
+import { YDoc, YjsDatabaseKey, YjsEditorKey } from '@/application/types';
+import * as Y from 'yjs';
+
+const nowSeconds = () => Math.floor(Date.now() / 1000);
+
+function rowMap (rowDoc: YDoc) {
+  return rowDoc.getMap(YjsEditorKey.data_section).get(YjsEditorKey.database_row) as Y.Map<unknown> | undefined;
+}
+
+export function updateRowCell (rowDoc: YDoc, fieldId: string, fieldType: FieldType, data: string) {
+  const row = rowMap(rowDoc);
+
+  if (!row) throw new Error('Row data not loaded');
+
+  rowDoc.transact(() => {
+    let cells = row.get(YjsDatabaseKey.cells) as Y.Map<unknown> | undefined;
+
+    if (!cells) {
+      cells = new Y.Map();
+      row.set(YjsDatabaseKey.cells, cells);
+    }
+
+    let cell = cells.get(fieldId) as Y.Map<unknown> | undefined;
+    const now = nowSeconds();
+
+    if (!cell) {
+      cell = new Y.Map();
+      cells.set(fieldId, cell);
+      cell.set(YjsDatabaseKey.field_type, fieldType);
+      cell.set(YjsDatabaseKey.created_at, now);
+    }
+
+    cell.set(YjsDatabaseKey.data, data);
+    cell.set(YjsDatabaseKey.last_modified, now);
+    row.set(YjsDatabaseKey.last_modified, now);
+  });
+}
+
+// Same serialization as collab-database's ChecklistCellData.
+export interface ChecklistData {
+  options: SelectOption[];
+  selected_option_ids: string[];
+}
+
+export function updateChecklistCell (rowDoc: YDoc, fieldId: string, data: ChecklistData) {
+  const options = data.options.map(({ id, name, color }) => ({ id, name, color }));
+  const ids = new Set(options.map((option) => option.id));
+  const selected = data.selected_option_ids.filter((id) => ids.has(id));
+
+  updateRowCell(rowDoc, fieldId, FieldType.Checklist, JSON.stringify({
+    options,
+    selected_option_ids: selected,
+  }));
+}
+
+// collab-database's gen_option_id(): nanoid(4)
+export function generateOptionId () {
+  const alphabet = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz-';
+  const bytes = crypto.getRandomValues(new Uint8Array(4));
+
+  return Array.from(bytes, (b) => alphabet[b & 63]).join('');
+}
+
+export function setRowDocumentNotEmpty (rowDoc: YDoc, rowId: string) {
+  const root = rowDoc.getMap(YjsEditorKey.data_section);
+  const meta = root.get(YjsEditorKey.meta) as Y.Map<unknown> | undefined;
+  const key = metaIdFromRowId(rowId)(RowMetaKey.IsDocumentEmpty);
+
+  if (!meta || meta.get(key) === false) return;
+  rowDoc.transact(() => {
+    meta.set(key, false);
+  });
+}
