index 0000000..faabcba
--- /dev/null
+++ b/src/components/_shared/reference/ReferenceInput.tsx
@@ -0,0 +1,109 @@
+// Added by the AppFlowy Home Assistant add-on (not part of upstream AppFlowy-Web
+// v0.1.18): a single-line text input with the `[[` / `@` page picker. Enter or
+// blur commits, Escape cancels.
+import useReferencePicker from '@/components/_shared/reference/useReferencePicker';
+import React, { useCallback, useEffect, useRef, useState } from 'react';
+
+export function ReferenceInput ({
+  value,
+  onCommit,
+  onCancel,
+  placeholder,
+  className,
+  autoFocus = true,
+  clearOnCommit = false,
+}: {
+  value: string;
+  onCommit: (value: string) => void;
+  onCancel?: () => void;
+  placeholder?: string;
+  className?: string;
+  autoFocus?: boolean;
+  clearOnCommit?: boolean;
+}) {
+  const inputRef = useRef<HTMLInputElement>(null);
+  const [text, setText] = useState(value);
+  const committed = useRef(false);
+
+  useEffect(() => {
+    setText(value);
+  }, [value]);
+
+  const handlePick = useCallback((start: number, end: number, marker: string) => {
+    const input = inputRef.current;
+
+    if (!input) return;
+    const next = `${input.value.slice(0, start)}${marker} ${input.value.slice(end)}`;
+    const caret = start + marker.length + 1;
+
+    setText(next);
+    requestAnimationFrame(() => {
+      input.focus();
+      input.setSelectionRange(caret, caret);
+    });
+  }, []);
+
+  const picker = useReferencePicker({ onPick: handlePick });
+
+  const syncPicker = useCallback(() => {
+    const input = inputRef.current;
+
+    if (!input) return;
+    picker.update(input.value, input.selectionStart ?? input.value.length, input);
+  }, [picker]);
+
+  const commit = useCallback(() => {
+    if (committed.current) return;
+    committed.current = true;
+    picker.close();
+    onCommit(text.trim());
+    if (clearOnCommit) setText('');
+    requestAnimationFrame(() => {
+      committed.current = false;
+    });
+  }, [clearOnCommit, onCommit, picker, text]);
+
+  return (
+    <>
+      <input
+        ref={inputRef}
+        value={text}
+        autoFocus={autoFocus}
+        placeholder={placeholder}
+        className={`w-full min-w-0 bg-transparent outline-none ${className || ''}`}
+        onChange={(e) => {
+          setText(e.target.value);
+          picker.update(e.target.value, e.target.selectionStart ?? e.target.value.length, e.target);
+        }}
+        onClick={syncPicker}
+        onKeyUp={(e) => {
+          if (e.key === 'ArrowLeft' || e.key === 'ArrowRight' || e.key === 'Home' || e.key === 'End') syncPicker();
+        }}
+        onKeyDown={(e) => {
+          e.stopPropagation();
+          if (picker.onKeyDown(e)) return;
+          if (e.key === 'Enter') {
+            e.preventDefault();
+            commit();
+          } else if (e.key === 'Escape') {
+            e.preventDefault();
+            committed.current = true;
+            picker.close();
+            setText(value);
+            onCancel?.();
+            requestAnimationFrame(() => {
+              committed.current = false;
+            });
+          }
+        }}
+        onBlur={() => {
+          if (!clearOnCommit || text.trim()) commit();
+          else onCancel?.();
+        }}
+      />
+      {picker.element}
+    </>
+  );
+}
+
+export default ReferenceInput;
diff --git a/src/components/_shared/reference/ReferenceText.tsx b/src/components/_shared/reference/ReferenceText.tsx
