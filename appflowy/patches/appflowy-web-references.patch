diff --git a/src/utils/referenceMarker.ts b/src/utils/referenceMarker.ts
new file mode 100644
index 0000000..de7a82c
--- /dev/null
+++ b/src/utils/referenceMarker.ts
@@ -0,0 +1,72 @@
+// Added by the AppFlowy Home Assistant add-on (not part of upstream AppFlowy-Web
+// v0.1.18): page references inside plain-text names (page titles, row titles,
+// checklist items). They are stored as `[[Name|view-id]]`, since those names
+// are plain strings in the collab data; other clients show the raw marker.
+
+export type ReferenceSegment =
+  | { type: 'text'; text: string }
+  | { type: 'reference'; name: string; viewId: string };
+
+const MARKER = /\[\[([^\]|\n]+)\|([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})\]\]/g;
+
+export function hasReferences (text?: string | null) {
+  if (!text) return false;
+  MARKER.lastIndex = 0;
+  return MARKER.test(text);
+}
+
+export function parseReferences (text?: string | null): ReferenceSegment[] {
+  if (!text) return [];
+  const segments: ReferenceSegment[] = [];
+  let last = 0;
+
+  MARKER.lastIndex = 0;
+  for (let match = MARKER.exec(text); match; match = MARKER.exec(text)) {
+    if (match.index > last) segments.push({ type: 'text', text: text.slice(last, match.index) });
+    segments.push({ type: 'reference', name: match[1].trim(), viewId: match[2].toLowerCase() });
+    last = match.index + match[0].length;
+  }
+
+  if (last < text.length) segments.push({ type: 'text', text: text.slice(last) });
+  return segments;
+}
+
+// The name with every marker replaced by the referenced page's name, for places
+// that can only show plain text (sidebar, breadcrumbs, browser tab, search).
+export function plainName (text?: string | null) {
+  if (!text) return text || '';
+  MARKER.lastIndex = 0;
+  return text.replace(MARKER, (_, name: string) => name.trim());
+}
+
+export function makeMarker (name: string, viewId: string) {
+  const clean = plainName(name).replace(/[[\]|\n]/g, ' ').replace(/\s+/g, ' ').trim();
+
+  return `[[${clean || viewId}|${viewId}]]`;
+}
+
+export enum ReferenceTrigger {
+  Brackets = '[[',
+  At = '@',
+}
+
+// The reference being typed right before the caret: `[[query` (anything but
+// brackets, pipes and line breaks) or `@query` (no whitespace, at a word start).
+export function findReferenceQuery (text: string, caret: number) {
+  const before = text.slice(0, caret);
+  const brackets = /\[\[([^[\]|\n]{0,60})$/.exec(before);
+
+  if (brackets) {
+    return { trigger: ReferenceTrigger.Brackets, query: brackets[1], start: brackets.index, end: caret };
+  }
+
+  const at = /(^|\s)@([^\s@[\]|]{0,60})$/.exec(before);
+
+  if (at) {
+    const start = at.index + at[1].length;
+
+    return { trigger: ReferenceTrigger.At, query: at[2], start, end: caret };
+  }
+
+  return null;
+}
